---
const lang = Astro.currentLocale || 'en';

const t = {
  en: {
    eyebrow: "Technology & Innovation",
    title: "SUPPORTED BY MODERN TECHNOLOGY SYSTEMS AND MACHINERY"
  },
  id: {
    eyebrow: "Teknologi & Inovasi",
    title: "DIDUKUNG DENGAN SISTEM TEKNOLOGI DAN MESIN YANG MODERN"
  }
}[lang];
---
<section id="technology-support" class="py-24 relative overflow-hidden bg-slate-50">
  <!-- Animated Background Elements -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none bg-gradient-to-br from-background-light to-secondary/20">
    <!-- Base Glow -->
    <div class="absolute top-0 left-1/4 w-[40rem] h-[40rem] bg-primary/10 rounded-full blur-[100px]"></div>
    <div class="absolute bottom-0 right-1/4 w-[30rem] h-[30rem] bg-[#C5A059]/10 rounded-full blur-[100px]"></div>

    <!-- Static Washing Machine Watermarks -->
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.75" stroke-linecap="round" stroke-linejoin="round" class="absolute -left-10 top-10 md:-left-20 md:top-10 w-64 h-64 md:w-[30rem] md:h-[30rem] text-primary opacity-20 -rotate-12">
      <path d="M14 19v3a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1v-3" />
      <path d="M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z" />
      <circle cx="12" cy="14" r="4" />
      <path d="M8 8h.01" />
      <path d="M12 8h.01" />
    </svg>
    
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.75" stroke-linecap="round" stroke-linejoin="round" class="absolute -right-10 bottom-10 md:-right-20 md:bottom-10 w-64 h-64 md:w-[30rem] md:h-[30rem] text-secondary opacity-20 rotate-12">
      <path d="M14 19v3a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1v-3" />
      <path d="M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z" />
      <circle cx="12" cy="14" r="4" />
      <path d="M8 8h.01" />
      <path d="M12 8h.01" />
    </svg>

    <!-- Floating Tech Bubbles -->
    <ul class="floating-bubbles absolute inset-0 w-full h-full m-0 p-0 text-primary">
      <li></li>
      <li></li>
      <li></li>
      <li></li>
      <li></li>
      <li></li>
      <li></li>
      <li></li>
      <li></li>
      <li></li>
    </ul>
  </div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="text-center mb-16">
      <span class="text-blue-600 font-semibold tracking-wider uppercase text-sm mb-4 block">
        {t.eyebrow}
      </span>
      <h2
        class="font-display text-3xl md:text-4xl font-bold text-primary leading-tight max-w-2xl mx-auto"
      >
        {t.title}
      </h2>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-6 lg:gap-8">
      {
        ["/images/about3.jpeg", "/images/about7.png", "/images/about8.png"].map(
          (img, index) => (
            <div class={`rounded-2xl overflow-hidden shadow-[0_8px_30px_rgb(0,0,0,0.08)] hover:shadow-[0_8px_30px_rgb(0,0,0,0.16)] group relative bg-white transition-all duration-500 border border-slate-100 hover:-translate-y-2 ${index === 0 ? 'col-span-2 md:col-span-1 aspect-[16/9] md:aspect-[4/3]' : 'col-span-1 md:col-span-1 aspect-square md:aspect-[4/3]'}`}>
              <div class="absolute inset-0 bg-blue-900/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10 pointer-events-none"></div>
              <img
                src={img}
                alt={`Modern Laundry Machine ${index + 1}`}
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000"
              />
            </div>
          ),
        )
      }
    </div>
  </div>
</section>

<style is:global>
  .floating-bubbles li {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    list-style: none;
    background: rgb(var(--color-primary) / 0.1);
    border: 2px solid rgb(var(--color-primary) / 0.4);
    box-shadow: 0 0 20px rgb(var(--color-primary) / 0.2);
    animation: floatUp 25s linear infinite;
    bottom: -200px;
    border-radius: 50%;
    backdrop-filter: blur(3px);
  }

  .floating-bubbles li:nth-child(even) {
    background: rgb(var(--color-secondary) / 0.15);
    border: 2px solid rgb(var(--color-secondary) / 0.5);
    box-shadow: 0 0 20px rgb(var(--color-secondary) / 0.25);
  }

  .floating-bubbles li:nth-child(3n) {
    background: rgba(197, 160, 89, 0.12);
    border: 2px solid rgba(197, 160, 89, 0.4);
    box-shadow: 0 0 20px rgba(197, 160, 89, 0.2);
  }

  /* Different sizes, positions, and animation speeds */
  .floating-bubbles li:nth-child(1) { left: 10%; width: 80px; height: 80px; animation-delay: 0s; animation-duration: 18s; }
  .floating-bubbles li:nth-child(2) { left: 25%; width: 40px; height: 40px; animation-delay: 2s; animation-duration: 15s; }
  .floating-bubbles li:nth-child(3) { left: 70%; width: 120px; height: 120px; animation-delay: 4s; animation-duration: 22s; }
  .floating-bubbles li:nth-child(4) { left: 40%; width: 60px; height: 60px; animation-delay: 0s; animation-duration: 16s; }
  .floating-bubbles li:nth-child(5) { left: 65%; width: 35px; height: 35px; animation-delay: 0s; animation-duration: 14s; }
  .floating-bubbles li:nth-child(6) { left: 75%; width: 90px; height: 90px; animation-delay: 3s; animation-duration: 19s; }
  .floating-bubbles li:nth-child(7) { left: 15%; width: 150px; height: 150px; animation-delay: 7s; animation-duration: 26s; }
  .floating-bubbles li:nth-child(8) { left: 50%; width: 25px; height: 25px; animation-delay: 15s; animation-duration: 12s; }
  .floating-bubbles li:nth-child(9) { left: 20%; width: 30px; height: 30px; animation-delay: 2s; animation-duration: 17s; }
  .floating-bubbles li:nth-child(10) { left: 85%; width: 110px; height: 110px; animation-delay: 0s; animation-duration: 24s; }

  @keyframes floatUp {
    0% {
      transform: translateY(0) rotate(0deg) scale(1);
      opacity: 1;
      border-radius: 50%;
    }
    100% {
      transform: translateY(-1200px) rotate(360deg) scale(1.2);
      opacity: 0;
      border-radius: 35%;
    }
  }
</style>
