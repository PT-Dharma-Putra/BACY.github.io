---
const lang = Astro.currentLocale || "en";

const t = {
  en: {
    desc: "A healthcare linen and laundry management company specializing in high-quality, sterile, and efficient solutions for medical facilities.",
    nav: "Navigation",
    links: [
      { name: "Home", href: "#home" },
      { name: "About", href: "#about" },
      { name: "Services", href: "#services" },
      { name: "Projects", href: "#projects" },
      { name: "Certificates", href: "#certificates" },
    ],
    headquarters: "The Headquarters",
    callUs: "Call Us",
    emailUs: "Email Us",
    bottomTag: "Crafting Professional Environments",
  },
  id: {
    desc: "Perusahaan manajemen linen dan laundry kesehatan yang berfokus pada solusi berkualitas tinggi, steril, dan efisien untuk fasilitas medis.",
    nav: "Navigasi",
    links: [
      { name: "Beranda", href: "#home" },
      { name: "Tentang", href: "#about" },
      { name: "Layanan", href: "#services" },
      { name: "Proyek", href: "#projects" },
      { name: "Sertifikat", href: "#certificates" },
    ],
    headquarters: "Kantor Pusat",
    callUs: "Hubungi Kami",
    emailUs: "Email Kami",
    bottomTag: "Menciptakan Lingkungan Profesional",
  },
}[lang];
---

<footer
  class="relative bg-[#050505] text-white pt-16 pb-8 overflow-hidden border-t border-white/5"
>
  <!-- Subtle Background Texture -->
  <div
    class="absolute inset-0 z-0 opacity-20 pointer-events-none mix-blend-overlay bg-[url('https://grainy-gradients.vercel.app/noise.svg')]"
  >
  </div>

  <!-- Top Highlight Line -->
  <div
    class="absolute top-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-primary/50 to-transparent"
  >
  </div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      <!-- Brand & Description -->
      <div class="lg:col-span-1 space-y-6">
        <a href="#home" class="group inline-block">
          <div class="flex items-center gap-3">
            <div class="relative">
              <img
                src="/images/logo_bacy.png"
                alt="PT BACY Logo"
                class="h-11 w-auto object-contain brightness-110"
              />
              <div
                class="absolute -inset-2 bg-primary/20 blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"
              >
              </div>
            </div>
            <span
              class="text-xl font-display font-bold text-white tracking-wider"
            >
              PT <span class="text-primary italic">BACY</span>
            </span>
          </div>
        </a>
        <p class="text-white/40 text-xs leading-relaxed max-w-sm">
          {t.desc}
        </p>
        <!-- Social Icons -->
        <div class="flex gap-3">
          <a
            href="https://www.instagram.com/dharmaputrainterior/?hl=en"
            target="_blank"
            class="w-8 h-8 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-white/40 hover:text-primary hover:border-primary/50 hover:bg-primary/5 transition-all duration-300"
          >
            <span class="material-icons-outlined text-base">camera_alt</span>
          </a>
          <a
            href="https://www.linkedin.com/company/pt-dharma-putra-sejahtera-abadi/"
            target="_blank"
            class="w-8 h-8 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-white/40 hover:text-primary hover:border-primary/50 hover:bg-primary/5 transition-all duration-300"
          >
            <span class="material-icons-outlined text-base">work</span>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="space-y-6">
        <h4
          class="font-display font-bold text-[10px] uppercase tracking-[0.3em] text-white/90"
        >
          {t.nav}
        </h4>
        <ul class="space-y-3">
          {
            t.links.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="footer-link group flex items-center gap-2 text-xs text-white/40 hover:text-white transition-colors duration-300"
                >
                  <span class="w-0 group-hover:w-3 h-[1px] bg-primary transition-all duration-300 overflow-hidden" />
                  {item.name}
                </a>
              </li>
            ))
          }
          <!-- <li>
            <a
              href="https://www.trackingorderdpsa.xyz/"
              target="_blank"
              class="footer-link group flex items-center gap-2 text-xs text-white/40 hover:text-white transition-colors duration-300"
            >
              <span
                class="w-0 group-hover:w-3 h-[1px] bg-primary transition-all duration-300 overflow-hidden"
              ></span>
              Track Order
            </a>
          </li> -->
        </ul>
      </div>

      <!-- Contact Info -->
      <div class="lg:col-span-2 space-y-6 lg:pl-12 border-l border-white/5">
        <h4
          class="font-display font-bold text-[10px] uppercase tracking-[0.3em] text-white/90"
        >
          {t.headquarters}
        </h4>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="space-y-3">
            <div class="flex items-start gap-3 text-white/40">
              <span class="material-icons-outlined text-primary text-lg"
                >location_on</span
              >
              <p class="text-xs leading-relaxed">
                Jl. Watugendong RT.01 /RW.15 Candibinangun, Pakem, Kab. Sleman,
                DI Yogyakarta.
              </p>
            </div>
          </div>
          <div class="space-y-4">
            <a
              href="https://wa.me/6281128507788"
              class="flex items-center gap-3 text-white/40 hover:text-white transition-colors group"
            >
              <div
                class="w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center group-hover:bg-primary/10 group-hover:border-primary/50 transition-all duration-500"
              >
                <span class="material-icons-outlined text-primary text-base"
                  >phone</span
                >
              </div>
              <div>
                <p
                  class="text-[8px] font-bold uppercase tracking-widest text-white/20"
                >
                  {t.callUs}
                </p>
                <p class="text-xs font-medium">+62 811-2850-7788</p>
              </div>
            </a>
            <a
              href="mailto:marketing@dharmaputrainterior.co.id"
              class="flex items-center gap-3 text-white/40 hover:text-white transition-colors group"
            >
              <div
                class="w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center group-hover:bg-primary/10 group-hover:border-primary/50 transition-all duration-500"
              >
                <span class="material-icons-outlined text-primary text-base"
                  >email</span
                >
              </div>
              <div>
                <p
                  class="text-[8px] font-bold uppercase tracking-widest text-white/20"
                >
                  {t.emailUs}
                </p>
                <p class="text-xs font-medium">
                  marketing@dharmaputrainterior.co.id
                </p>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div
      class="pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-4"
    >
      <p class="text-[9px] font-bold uppercase tracking-[0.3em] text-white/20">
        © 2026 PT. BERSIH AMAN CEMERLANG YOGYA (PT BACY). ALL RIGHTS RESERVED.
      </p>
      <div class="flex gap-6">
        <p
          class="text-[9px] font-bold uppercase tracking-[0.3em] text-white/10 italic"
        >
          {t.bottomTag}
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-link:hover {
    padding-left: 0.3rem;
  }
</style>
