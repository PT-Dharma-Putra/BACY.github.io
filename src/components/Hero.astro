---
// Hero.astro — Elegant & Professional Hero Section
const lang = Astro.currentLocale || 'en';

const t = {
  en: {
    eyebrow: "Healthcare Linen & Management Consultancy",
    title1: "Trusted Linen",
    title2: "Solution for",
    title3: "Healthcare Facilities",
    desc: "PT BACY delivers high-quality linen management services with international standards — maintaining hygiene, safety, and operational efficiency of your hospital every day.",
    btnPrimary: "Our Services",
    btnSecondary: "Free Consultation",
    stat1: "Hygiene Standard",
    stat2: "Hospital Partners",
    stat3: "Operational Service"
  },
  id: {
    eyebrow: "Healthcare Linen & Management Consultancy",
    title1: "Solusi Linen",
    title2: "Terpercaya untuk",
    title3: "Fasilitas Kesehatan",
    desc: "PT BACY menghadirkan layanan manajemen linen berkualitas tinggi dengan standar internasional — menjaga kebersihan, keamanan, dan efisiensi operasional rumah sakit Anda setiap hari.",
    btnPrimary: "Layanan Kami",
    btnSecondary: "Konsultasi Gratis",
    stat1: "Standar Higienitas",
    stat2: "Mitra Rumah Sakit",
    stat3: "Layanan Operasional"
  }
}[lang];
---

<section
  id="home"
  class="hero-section relative min-h-screen flex items-center justify-center overflow-hidden"
>
  <!-- ═══════════════════════════════════════════ -->
  <!--  BACKGROUND LAYERS                          -->
  <!-- ═══════════════════════════════════════════ -->

  <!-- Base Image -->
  <div class="hero-bg-wrap absolute inset-0 z-0">
    <img
      src="/images/Hero.png"
      alt="BACY Healthcare Linen Facility"
      class="hero-bg-img w-full h-full object-cover"
    />
  </div>

  <!-- Dark Gradient Overlay — multi-directional for depth -->
  <div class="absolute inset-0 z-[1]">
    <!-- Bottom-to-top dark base -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#080e0a]/95 via-[#0d1e14]/70 to-transparent"></div>
    <!-- Left-to-right for text readability -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#080e0a]/80 via-[#0d1e14]/40 to-transparent"></div>
    <!-- Vignette rim -->
    <div class="absolute inset-0" style="background: radial-gradient(ellipse at center, transparent 30%, rgba(5,10,7,0.65) 100%);"></div>
  </div>

  <!-- ═══════════════════════════════════════════ -->
  <!--  DECORATIVE GEOMETRIC ELEMENTS              -->
  <!-- ═══════════════════════════════════════════ -->

  <!-- Gold accent glow top-right -->
  <div class="absolute top-[-80px] right-[-80px] w-[500px] h-[500px] rounded-full z-[2]"
    style="background: radial-gradient(circle, rgba(197,160,89,0.18) 0%, transparent 70%);"></div>

  <!-- Subtle green glow bottom-left -->
  <div class="absolute bottom-[-60px] left-[-60px] w-[400px] h-[400px] rounded-full z-[2]"
    style="background: radial-gradient(circle, rgba(45,90,76,0.25) 0%, transparent 70%);"></div>

  <!-- Decorative lines grid overlay -->
  <div class="hero-grid-overlay absolute inset-0 z-[2]"></div>

  <!-- Thin gold horizontal rule accent -->
  <div class="absolute top-1/2 right-0 w-[30vw] h-[1px] z-[3] hero-line-right"
    style="background: linear-gradient(to left, transparent, rgba(197,160,89,0.5));"></div>

  <!-- Floating circles (decorative) -->
  <div class="hero-circle hero-circle-1 absolute z-[3]"></div>
  <div class="hero-circle hero-circle-2 absolute z-[3]"></div>
  <div class="hero-circle hero-circle-3 absolute z-[3]"></div>

  <!-- ═══════════════════════════════════════════ -->
  <!--  MAIN CONTENT                               -->
  <!-- ═══════════════════════════════════════════ -->

  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 lg:px-12 pt-24 pb-28">
    <div class="grid lg:grid-cols-12 gap-8 items-end">

      <!-- LEFT — Primary Content -->
      <div class="lg:col-span-7 space-y-8">

        <!-- Eyebrow badge -->
        <div class="hero-eyebrow inline-flex items-center gap-3">
          <span class="hero-eyebrow-dot"></span>
          <span class="text-xs font-semibold tracking-[0.25em] text-[#C5A059] uppercase">
            {t.eyebrow}
          </span>
        </div>

        <!-- Main headline -->
        <div class="hero-headline-wrap space-y-2">
          <h1 class="hero-headline font-display font-bold leading-[1.05] tracking-tight text-white">
            <span class="hero-word block overflow-hidden">
              <span class="hero-word-inner">{t.title1}</span>
            </span>
            <span class="hero-word block overflow-hidden">
              <span class="hero-word-inner hero-word-delay-1">{t.title2}</span>
            </span>
            <span class="hero-word block overflow-hidden">
              <span class="hero-word-inner hero-word-delay-2 hero-gold-text">{t.title3}</span>
            </span>
          </h1>
        </div>

        <!-- Descriptor line -->
        <p class="hero-desc text-white/65 text-base md:text-lg leading-relaxed max-w-xl font-light">
          {t.desc}
        </p>

        <!-- CTA row -->
        <div class="hero-cta-row flex flex-wrap gap-4 items-center">
          <a href="#services" class="hero-btn-primary group">
            <span>{t.btnPrimary}</span>
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"/>
            </svg>
          </a>
          <a href="#contact" class="hero-btn-secondary group">
            <svg class="w-4 h-4 text-[#C5A059]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
            </svg>
            <span>{t.btnSecondary}</span>
          </a>
        </div>

        <!-- Since badge -->
        <div class="hero-since">
          <span class="text-white/35 text-sm tracking-widest font-light">SINCE</span>
          <span class="text-[#C5A059] text-sm font-semibold tracking-widest ml-2">2023</span>
        </div>

      </div>

      <!-- RIGHT — Floating Stats Cards -->
      <div class="lg:col-span-5 flex flex-col items-end gap-4 hero-stats-col">

        <div class="hero-stat-card hero-stat-delay-1">
          <div class="hero-stat-icon">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.955 11.955 0 003 12c0 6.627 5.373 12 12 12s12-5.373 12-12c0-1.954-.468-3.802-1.297-5.438l-.157-.291"/>
            </svg>
          </div>
          <div>
            <div class="hero-stat-number" data-count="100">100<span>%</span></div>
            <div class="hero-stat-label">{t.stat1}</div>
          </div>
        </div>

        <div class="hero-stat-card hero-stat-delay-2">
          <div class="hero-stat-icon">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21"/>
            </svg>
          </div>
          <div>
            <div class="hero-stat-number" data-count="50">50<span>+</span></div>
            <div class="hero-stat-label">{t.stat2}</div>
          </div>
        </div>

        <div class="hero-stat-card hero-stat-delay-3">
          <div class="hero-stat-icon">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <div class="hero-stat-number">24<span>/7</span></div>
            <div class="hero-stat-label">{t.stat3}</div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════ -->
  <!--  SCROLL INDICATOR                           -->
  <!-- ═══════════════════════════════════════════ -->
  <div class="hero-scroll-cue absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2">
    <span class="text-white/35 text-[10px] tracking-[0.3em] uppercase font-light">Scroll</span>
    <div class="hero-scroll-track">
      <div class="hero-scroll-thumb"></div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════ -->
<style>
  /* ── FONTS ── */
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300&display=swap');

  /* ── SECTION ── */
  .hero-section {
    font-family: 'Plus Jakarta Sans', sans-serif;
    background: #080e0a;
  }

  /* ── BACKGROUND PARALLAX ZOOM ── */
  .hero-bg-img {
    transform-origin: center center;
    animation: heroZoom 22s ease-out forwards;
    will-change: transform;
  }
  @keyframes heroZoom {
    0%   { transform: scale(1.08); }
    100% { transform: scale(1); }
  }

  /* ── GRID OVERLAY ── */
  .hero-grid-overlay {
    background-image:
      linear-gradient(rgba(197,160,89,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(197,160,89,0.04) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
  }

  /* ── FLOATING CIRCLES ── */
  .hero-circle {
    border-radius: 50%;
    border: 1px solid rgba(197,160,89,0.15);
    pointer-events: none;
  }
  .hero-circle-1 {
    width: 320px; height: 320px;
    top: 10%; right: 5%;
    animation: floatCircle 8s ease-in-out infinite;
  }
  .hero-circle-2 {
    width: 180px; height: 180px;
    top: 25%; right: 18%;
    border-color: rgba(45,90,76,0.2);
    animation: floatCircle 6s ease-in-out infinite reverse;
  }
  .hero-circle-3 {
    width: 80px; height: 80px;
    top: 55%; right: 12%;
    background: rgba(197,160,89,0.06);
    animation: floatCircle 5s ease-in-out infinite 1s;
  }
  @keyframes floatCircle {
    0%, 100% { transform: translate(0, 0); }
    50%       { transform: translate(-12px, -18px); }
  }

  /* ── HORIZONTAL ACCENT LINE ── */
  .hero-line-right {
    animation: lineSlideIn 1.8s cubic-bezier(0.22,1,0.36,1) 0.6s both;
  }
  @keyframes lineSlideIn {
    from { transform: scaleX(0); transform-origin: right; opacity: 0; }
    to   { transform: scaleX(1); transform-origin: right; opacity: 1; }
  }

  /* ── EYEBROW BADGE ── */
  .hero-eyebrow {
    animation: fadeSlideUp 0.9s cubic-bezier(0.22,1,0.36,1) 0.2s both;
  }
  .hero-eyebrow-dot {
    display: inline-block;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #C5A059;
    box-shadow: 0 0 10px rgba(197,160,89,0.8);
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 8px rgba(197,160,89,0.6); }
    50%       { box-shadow: 0 0 18px rgba(197,160,89,1); }
  }

  /* ── WORD REVEAL ANIMATION ── */
  .hero-word { display: block; }
  .hero-word-inner {
    display: block;
    animation: wordReveal 0.9s cubic-bezier(0.22,1,0.36,1) 0.4s both;
  }
  .hero-word-delay-1 .hero-word-inner,
  .hero-word-delay-1 {
    animation-delay: 0.55s;
  }
  .hero-word-delay-2 .hero-word-inner,
  .hero-word-delay-2 {
    animation-delay: 0.7s;
  }
  @keyframes wordReveal {
    from { transform: translateY(100%); opacity: 0; }
    to   { transform: translateY(0);   opacity: 1; }
  }

  /* ── HEADLINE SIZE ── */
  .hero-headline {
    font-size: clamp(2.4rem, 5.5vw, 4.5rem);
  }

  /* ── GOLD GRADIENT TEXT ── */
  .hero-gold-text {
    background: linear-gradient(135deg, #C5A059 0%, #E5C27B 45%, #C5A059 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* ── DESCRIPTOR ── */
  .hero-desc {
    animation: fadeSlideUp 1s cubic-bezier(0.22,1,0.36,1) 0.85s both;
  }

  /* ── CTA ROW ── */
  .hero-cta-row {
    animation: fadeSlideUp 1s cubic-bezier(0.22,1,0.36,1) 1.0s both;
  }

  /* Primary button */
  .hero-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(135deg, #C5A059, #E5C27B);
    color: #080e0a;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    padding: 14px 28px;
    border-radius: 4px;
    transition: all 0.35s cubic-bezier(0.22,1,0.36,1);
    box-shadow: 0 6px 24px rgba(197,160,89,0.35);
    position: relative;
    overflow: hidden;
  }
  .hero-btn-primary::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.15), transparent);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .hero-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 36px rgba(197,160,89,0.55);
  }
  .hero-btn-primary:hover::before { opacity: 1; }
  .hero-btn-primary:active { transform: translateY(0); }

  /* Secondary button */
  .hero-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(255,255,255,0.06);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.15);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-decoration: none;
    padding: 14px 28px;
    border-radius: 4px;
    transition: all 0.35s cubic-bezier(0.22,1,0.36,1);
  }
  .hero-btn-secondary:hover {
    background: rgba(255,255,255,0.12);
    border-color: rgba(197,160,89,0.4);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
  }

  /* ── SINCE ── */
  .hero-since {
    animation: fadeSlideUp 1s cubic-bezier(0.22,1,0.36,1) 1.15s both;
  }

  /* ── STAT CARDS ── */
  .hero-stats-col {
    animation: fadeSlideUp 1s cubic-bezier(0.22,1,0.36,1) 0.8s both;
  }

  .hero-stat-card {
    display: flex;
    align-items: center;
    gap: 16px;
    background: rgba(8,14,10,0.55);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(197,160,89,0.2);
    border-radius: 12px;
    padding: 16px 22px;
    min-width: 220px;
    position: relative;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.22,1,0.36,1);
    opacity: 0;
  }
  .hero-stat-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 3px; height: 100%;
    background: linear-gradient(to bottom, #C5A059, transparent);
    border-radius: 3px 0 0 3px;
  }
  .hero-stat-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(197,160,89,0.06) 0%, transparent 60%);
    pointer-events: none;
  }
  .hero-stat-card:hover {
    border-color: rgba(197,160,89,0.45);
    transform: translateX(-6px);
    box-shadow: 0 12px 36px rgba(0,0,0,0.35);
  }

  .hero-stat-delay-1 { animation: statSlideIn 0.7s cubic-bezier(0.22,1,0.36,1) 1.1s forwards; }
  .hero-stat-delay-2 { animation: statSlideIn 0.7s cubic-bezier(0.22,1,0.36,1) 1.25s forwards; }
  .hero-stat-delay-3 { animation: statSlideIn 0.7s cubic-bezier(0.22,1,0.36,1) 1.4s forwards; }
  @keyframes statSlideIn {
    from { transform: translateX(40px); opacity: 0; }
    to   { transform: translateX(0);    opacity: 1; }
  }

  .hero-stat-icon {
    flex-shrink: 0;
    width: 42px; height: 42px;
    border-radius: 10px;
    background: rgba(197,160,89,0.12);
    border: 1px solid rgba(197,160,89,0.25);
    display: flex; align-items: center; justify-content: center;
    color: #C5A059;
  }

  .hero-stat-number {
    font-size: 1.6rem;
    font-weight: 800;
    color: #fff;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .hero-stat-number span {
    color: #C5A059;
    font-size: 1rem;
    font-weight: 700;
  }
  .hero-stat-label {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.5);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-top: 2px;
  }

  /* ── SCROLL INDICATOR ── */
  .hero-scroll-cue {
    animation: fadeSlideUp 1s cubic-bezier(0.22,1,0.36,1) 1.8s both;
  }
  .hero-scroll-track {
    width: 1px;
    height: 50px;
    background: rgba(255,255,255,0.15);
    position: relative;
    overflow: hidden;
    border-radius: 1px;
  }
  .hero-scroll-thumb {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 50%;
    background: linear-gradient(to bottom, #C5A059, transparent);
    border-radius: 1px;
    animation: scrollThumb 2s ease-in-out infinite;
  }
  @keyframes scrollThumb {
    0%   { transform: translateY(-100%); }
    100% { transform: translateY(200%); }
  }

  /* ── SHARED ANIMATION ── */
  @keyframes fadeSlideUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── RESPONSIVE TWEAKS ── */
  @media (max-width: 1023px) {
    .hero-stats-col {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: flex-start;
      align-items: stretch;
    }
    .hero-stat-card { min-width: auto; flex: 1 1 160px; }
    .hero-stat-card:hover { transform: translateY(-4px) !important; }
    .hero-circle-1, .hero-circle-2, .hero-circle-3 { display: none; }
  }
  @media (max-width: 640px) {
    .hero-stat-card { flex: 1 1 100%; }
  }
</style>
