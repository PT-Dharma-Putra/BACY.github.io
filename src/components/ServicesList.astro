---
const lang = Astro.currentLocale || 'en';

const t = {
  en: {
    title: "OUR SERVICES",
    services: [
      {
        title: "Linen Parstock Allocation",
        tagline: "Optimized inventory management",
        desc: "Linen parstock management (optional) to guarantee seamless operations across various hospital care units based on patient volumes.",
        icon: "layers",
        visualType: "parstock",
        bullets: [
          "5 Parstock for VK (ER), OK (OR), and Baby units",
          "3 Parstock for ICU, Polyclinic, and Outpatient units",
          "Prevents linen shortage under any operational conditions"
        ]
      },
      {
        title: "Pick-Up & Delivery Service",
        tagline: "One Day Service under 3T principles",
        desc: "Fast and scheduled distribution of dirty and clean linens, optimizing hospital logistics and operations.",
        icon: "local_shipping",
        visualType: "delivery",
        bullets: [
          "On Quality (Tepat Mutu): Preserving linen hygiene during transit",
          "On Time (Tepat Waktu): Reliable 24-hour turnaround service",
          "On Budget (Tepat Budget): Cost-efficient logistics with zero hidden fees"
        ]
      },
      {
        title: "Linen Quality Standards",
        tagline: "Clean, odorless, and hygienic",
        desc: "Linens are processed using modern laundry technologies and eco-friendly formulas meeting strict sanitary codes.",
        icon: "verified_user",
        visualType: "quality",
        bullets: [
          "Spotless clean free of tough stains",
          "Odorless and infuses long-lasting freshness",
          "Clinically hygienic & sterile for patient safety"
        ]
      },
      {
        title: "LMS Training & Integration",
        tagline: "Digital laundry management system",
        desc: "Comprehensive onboarding for Hospital laundry PICs and users on the digital Laundry Management System (LMS).",
        icon: "co_present",
        visualType: "lms",
        bullets: [
          "Training for web and Android-based LMS applications",
          "Real-time linen inventory tracking and reporting",
          "Monitoring washing cycles and lifecycle history of linen assets"
        ]
      },
      {
        title: "Quarterly Performance Reports",
        tagline: "Compliance and clinical lab updates",
        desc: "We provide comprehensive laboratory and performance reports every 3 months for complete operational transparency.",
        icon: "analytics",
        visualType: "reports",
        bullets: [
          "Linen Swab test results certifying sterile output",
          "Inbound water quality analysis to ensure clean washing",
          "Liquid waste treatment testing meeting environmental standards"
        ]
      },
      {
        title: "Routine Stock Opname",
        tagline: "Inventory audit and asset accountability",
        desc: "Regular audits to verify active linen stock, prevent asset shrinkage, and monitor circulation patterns.",
        icon: "inventory",
        visualType: "stock",
        bullets: [
          "Comprehensive physical inventory count performed monthly",
          "Random spot-checks weekly for tight operational control",
          "Minimizes asset loss and avoids stock imbalance across wards"
        ]
      }
    ]
  },
  id: {
    title: "LAYANAN KAMI",
    services: [
      {
        title: "Alokasi Parstock Linen",
        tagline: "Optimasi persediaan unit rumah sakit",
        desc: "Penyediaan jumlah parstock linen untuk menjamin kelancaran operasional di setiap unit perawatan rumah sakit secara presisi.",
        icon: "layers",
        visualType: "parstock",
        bullets: [
          "5 Parstock untuk unit VK, OK, dan unit Bayi",
          "3 Parstock untuk unit ICU, Poliklinik, dan Rawat Jalan",
          "Mencegah kekosongan linen dalam kondisi operasional apapun"
        ]
      },
      {
        title: "Layanan Antar Jemput (Delivery)",
        tagline: "Sistem One Day Service dengan prinsip 3T",
        desc: "Pelayanan distribusi linen kotor dan bersih yang cepat dan terjadwal demi efisiensi waktu operasional rumah sakit.",
        icon: "local_shipping",
        visualType: "delivery",
        bullets: [
          "Tepat Mutu: Menjaga standar kebersihan linen dalam perjalanan",
          "Tepat Waktu: Layanan satu hari selesai (One Day Service)",
          "Tepat Budget: Biaya logistik yang teroptimasi tanpa biaya tambahan"
        ]
      },
      {
        title: "Standar Kualitas Linen",
        tagline: "Higienis, bersih, dan harum",
        desc: "Jaminan kebersihan linen yang diproses dengan teknologi modern dan bahan pencuci ramah lingkungan sesuai standar klinis.",
        icon: "verified_user",
        visualType: "quality",
        bullets: [
          "Bersih sempurna bebas dari noda membandel",
          "Bebas bau tidak sedap dan wangi segar tahan lama",
          "Higienis & steril untuk kenyamanan penuh pasien"
        ]
      },
      {
        title: "Pelatihan Sistem LMS",
        tagline: "Integrasi digital & edukasi pengguna",
        desc: "Sistem pelatihan Laundry Management System (LMS) digital untuk penanggung jawab (PIC) laundry dan pengguna rumah sakit.",
        icon: "co_present",
        visualType: "lms",
        bullets: [
          "Pelatihan penggunaan dashboard LMS berbasis web dan Android",
          "Manajemen data inventaris linen secara real-time",
          "Memudahkan pelacakan posisi dan histori pencucian linen"
        ]
      },
      {
        title: "Laporan Kinerja Berkala",
        tagline: "Transparansi data hasil uji klinis",
        desc: "Penyediaan laporan menyeluruh setiap 3 bulan sebagai bukti kepatuhan terhadap standar sanitasi dan lingkungan hidup.",
        icon: "analytics",
        visualType: "reports",
        bullets: [
          "Hasil uji usap linen (Swab Test) untuk jaminan sterilitas",
          "Hasil uji kualitas air bersih yang digunakan untuk proses cuci",
          "Hasil uji laboratorium berkala untuk pembuangan limbah cair"
        ]
      },
      {
        title: "Stock Opname Rutin",
        tagline: "Akurasi aset linen terjaga",
        desc: "Audit inventaris linen secara berkala untuk memastikan tidak adanya kehilangan aset dan melacak perputaran linen.",
        icon: "inventory",
        visualType: "stock",
        bullets: [
          "Stock opname menyeluruh yang rutin dilakukan setiap bulan",
          "Audit acak (random sampling) mingguan untuk kontrol ketat",
          "Mencegah penumpukan stok dan meminimalisir risiko kehilangan"
        ]
      }
    ]
  }
}[lang];

const services = t.services;
---

<section class="py-16 bg-white overflow-hidden" id="services">
  <div class="max-w-7xl mx-auto px-4 lg:px-6">
    <!-- Header -->
    <div class="flex items-center gap-6 mb-6">
      <h2 class="font-display text-4xl md:text-5xl font-bold text-primary tracking-widest whitespace-nowrap">
        {t.title}
      </h2>
      <div class="h-[3px] w-full bg-primary"></div>
    </div>

    <!-- Desktop Layout (Interactive Timeline & Cards Stack) -->
    <div class="hidden md:block w-full space-y-6">
      <!-- Horizontal Timeline Stepper -->
      <div class="flex flex-row justify-between items-center relative w-full pt-4 pb-6 px-4">
        <!-- Connecting Line background -->
        <div class="absolute top-1/2 -translate-y-1/2 left-[5%] right-[5%] h-[3px] bg-slate-100 -z-10 rounded-full"></div>
        <!-- Gold Active Progress Line -->
        <div id="timeline-progress-line" class="absolute top-1/2 -translate-y-1/2 left-[5%] h-[3px] bg-gradient-to-r from-primary to-[#C5A059] -z-10 rounded-full transition-all duration-500 ease-out" style="width: 0%;"></div>
        
        {
          services.map((step, idx) => (
            <button 
              class="flex-1 flex flex-col items-center text-center group cursor-pointer focus:outline-none timeline-step-btn" 
              data-index={idx}
            >
              <!-- Step Label -->
              <span class="text-[10px] font-extrabold uppercase tracking-widest text-slate-400 group-hover:text-primary transition-colors duration-300 mb-3 timeline-step-number">
                Step 0{idx + 1}
              </span>
              
              <!-- Circle node with Icon -->
              <div class="relative w-16 h-16 rounded-full bg-white text-slate-400 border-2 border-slate-200 flex items-center justify-center shadow-sm transition-all duration-500 z-10 timeline-step-circle group-hover:scale-105 group-hover:border-primary group-hover:text-primary">
                <!-- Pulse glowing ring for active state -->
                <div class="absolute -inset-1.5 rounded-full border border-[#C5A059]/40 opacity-0 timeline-step-pulse animate-pulse pointer-events-none"></div>
                
                <span class="material-icons-outlined text-2xl select-none">{step.icon}</span>
              </div>

              <!-- Brief Title -->
              <span class="text-[11px] font-bold text-slate-500 group-hover:text-primary transition-colors duration-300 mt-3 whitespace-nowrap timeline-step-title max-w-[120px] truncate">
                {step.title}
              </span>
            </button>
          ))
        }
      </div>

      <!-- Desktop Detail Showcase Card Container -->
      <div class="relative bg-[#fcfdfc] rounded-[32px] border border-slate-100 shadow-[0_8px_30px_rgba(26,57,42,0.02)] p-8 min-h-[340px] overflow-hidden">
        <!-- Ethereal background glows -->
        <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-primary/5 rounded-full blur-[80px] -z-10"></div>
        <div class="absolute -left-20 -top-20 w-80 h-80 bg-[#C5A059]/5 rounded-full blur-[80px] -z-10"></div>
        
        <div class="w-full">
          {
            services.map((step, idx) => (
              <div 
                class={`service-detail-card gap-10 items-center w-full ${idx === 0 ? 'flex flex-col lg:flex-row animate-fade-in-up' : 'hidden'}`}
                data-index={idx}
              >
                <!-- Left: Content Information -->
                <div class="flex-1 space-y-4 text-left">
                  <div class="flex items-center gap-3">
                    <span class="text-[10px] font-extrabold tracking-[0.2em] text-[#C5A059] uppercase bg-[#C5A059]/10 px-3 py-1 rounded-full">
                      Step 0{idx + 1}
                    </span>
                    <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
                      {step.tagline}
                    </span>
                  </div>
                  
                  <h3 class="font-display text-3xl font-bold text-primary leading-tight">
                    {step.title}
                  </h3>
                  
                  <p class="text-sm text-slate-600 leading-relaxed whitespace-pre-line">
                    {step.desc}
                  </p>
                  
                  <ul class="grid grid-cols-1 gap-2 pt-2">
                    {
                      step.bullets.map((bullet) => (
                        <li class="flex items-start gap-2.5 text-xs text-slate-700 font-medium">
                          <span class="material-icons-outlined text-primary text-sm mt-0.5 select-none">check_circle</span>
                          <span>{bullet}</span>
                        </li>
                      ))
                    }
                  </ul>
                </div>
                
                <!-- Right: Visual Mockup Panel -->
                <div class="w-full lg:w-[420px] shrink-0 h-[260px] flex items-center justify-center">
                  <div class="w-full h-full bg-white rounded-2xl border border-slate-100 shadow-[0_8px_30px_rgba(0,0,0,0.02)] p-6 flex flex-col justify-between relative overflow-hidden group/mockup hover:shadow-[0_12px_40px_rgba(0,0,0,0.05)] transition-all duration-300">
                    <div class="absolute inset-0 opacity-[0.015] pointer-events-none bg-[radial-gradient(#1A392A_1px,transparent_1px)] bg-[size:16px_16px]"></div>
                    
                    <!-- Conditional Mockup Details -->
                    {step.visualType === 'parstock' && (
                      <div class="w-full h-full flex flex-col justify-between">
                        <div class="flex justify-between items-center border-b border-slate-50 pb-2">
                          <span class="text-xs font-bold text-primary uppercase tracking-wider">Allocation Blueprint</span>
                          <span class="text-[10px] bg-emerald-50 text-emerald-750 font-semibold px-2 py-0.5 rounded">Active</span>
                        </div>
                        
                        <div class="space-y-4 my-auto">
                          <div>
                            <div class="flex justify-between text-[11px] text-slate-600 font-semibold mb-1">
                              <span>VK, OK, & Baby Units</span>
                              <span class="text-primary font-bold">5 Parstock</span>
                            </div>
                            <div class="flex gap-1.5">
                              <div class="h-2.5 flex-1 bg-primary rounded-full"></div>
                              <div class="h-2.5 flex-1 bg-primary rounded-full"></div>
                              <div class="h-2.5 flex-1 bg-primary rounded-full"></div>
                              <div class="h-2.5 flex-1 bg-primary rounded-full"></div>
                              <div class="h-2.5 flex-1 bg-primary rounded-full"></div>
                            </div>
                          </div>
                          
                          <div>
                            <div class="flex justify-between text-[11px] text-slate-600 font-semibold mb-1">
                              <span>ICU, Polyclinic, & Outpatient</span>
                              <span class="text-primary font-bold">3 Parstock</span>
                            </div>
                            <div class="flex gap-1.5">
                              <div class="h-2.5 flex-1 bg-primary rounded-full"></div>
                              <div class="h-2.5 flex-1 bg-primary rounded-full"></div>
                              <div class="h-2.5 flex-1 bg-primary rounded-full"></div>
                              <div class="h-2.5 flex-1 bg-slate-100 rounded-full"></div>
                              <div class="h-2.5 flex-1 bg-slate-100 rounded-full"></div>
                            </div>
                          </div>
                        </div>
                        
                        <div class="text-[10px] text-slate-400 text-center font-medium border-t border-slate-50 pt-2">
                          System designed to handle fluctuations in unit demands.
                        </div>
                      </div>
                    )}

                    {step.visualType === 'delivery' && (
                      <div class="w-full h-full flex flex-col justify-between">
                        <div class="flex justify-between items-center border-b border-slate-50 pb-2">
                          <span class="text-xs font-bold text-primary uppercase tracking-wider">Logistics Chain</span>
                          <span class="text-[10px] font-bold text-[#C5A059]">One Day Service</span>
                        </div>
                        
                        <div class="flex items-center justify-between my-auto relative px-2">
                          <div class="absolute left-6 right-6 top-5 border-t-2 border-dashed border-slate-100 -z-10"></div>
                          
                          <div class="flex flex-col items-center">
                            <div class="w-10 h-10 rounded-full bg-slate-50 border border-slate-100 flex items-center justify-center text-primary shadow-sm group-hover/mockup:bg-primary group-hover/mockup:text-white transition-colors duration-300">
                              <span class="material-icons-outlined text-lg">local_shipping</span>
                            </div>
                            <span class="text-[9px] font-bold text-slate-500 mt-1.5">Pick-Up</span>
                          </div>
                          
                          <div class="flex flex-col items-center">
                            <div class="w-10 h-10 rounded-full bg-[#C5A059]/10 border border-[#C5A059]/20 flex items-center justify-center text-[#C5A059] shadow-sm">
                              <span class="material-icons-outlined text-lg">local_laundry_service</span>
                            </div>
                            <span class="text-[9px] font-bold text-slate-500 mt-1.5">Wash</span>
                          </div>
                          
                          <div class="flex flex-col items-center">
                            <div class="w-10 h-10 rounded-full bg-slate-50 border border-slate-100 flex items-center justify-center text-primary shadow-sm group-hover/mockup:bg-primary group-hover/mockup:text-white transition-colors duration-300">
                              <span class="material-icons-outlined text-lg">verified</span>
                            </div>
                            <span class="text-[9px] font-bold text-slate-500 mt-1.5">Delivery</span>
                          </div>
                        </div>
                        
                        <div class="grid grid-cols-3 gap-2 border-t border-slate-50 pt-2 text-center">
                          <div class="bg-slate-50 rounded p-1">
                            <p class="text-[8px] text-slate-400 font-bold uppercase leading-none">Mutu</p>
                            <p class="text-[9px] font-black text-primary mt-0.5">100%</p>
                          </div>
                          <div class="bg-slate-50 rounded p-1">
                            <p class="text-[8px] text-slate-400 font-bold uppercase leading-none">Waktu</p>
                            <p class="text-[9px] font-black text-primary mt-0.5">24h</p>
                          </div>
                          <div class="bg-slate-50 rounded p-1">
                            <p class="text-[8px] text-slate-400 font-bold uppercase leading-none">Budget</p>
                            <p class="text-[9px] font-black text-primary mt-0.5">Optimized</p>
                          </div>
                        </div>
                      </div>
                    )}

                    {step.visualType === 'quality' && (
                      <div class="w-full h-full flex flex-col justify-between">
                        <div class="flex justify-between items-center border-b border-slate-50 pb-2">
                          <span class="text-xs font-bold text-primary uppercase tracking-wider">Quality Audit Indicators</span>
                          <span class="text-[10px] bg-emerald-50 text-emerald-700 font-semibold px-2 py-0.5 rounded">Pass</span>
                        </div>
                        
                        <div class="flex items-center gap-4 my-auto">
                          <div class="flex-1 space-y-2">
                            <div class="flex items-center gap-1.5">
                              <span class="material-icons-outlined text-emerald-500 text-sm">done</span>
                              <span class="text-[11px] font-semibold text-slate-600">Spotless Hygiene</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                              <span class="material-icons-outlined text-emerald-500 text-sm">done</span>
                              <span class="text-[11px] font-semibold text-slate-600">Fresh & Odorless</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                              <span class="material-icons-outlined text-emerald-500 text-sm">done</span>
                              <span class="text-[11px] font-semibold text-slate-600">Clinical Sterilization</span>
                            </div>
                          </div>
                          
                          <div class="w-24 h-24 rounded-full border-4 border-dashed border-[#C5A059]/40 flex items-center justify-center relative p-1 shrink-0">
                            <div class="w-full h-full rounded-full bg-[#C5A059] flex flex-col items-center justify-center text-white text-center shadow-md">
                              <span class="material-icons-outlined text-base">verified_user</span>
                              <span class="text-[8px] font-bold uppercase tracking-widest leading-none mt-1">100%</span>
                              <span class="text-[7px] font-bold uppercase tracking-widest leading-none">Hygiene</span>
                            </div>
                          </div>
                        </div>
                        
                        <div class="text-[10px] text-slate-400 text-center font-medium border-t border-slate-50 pt-2">
                          Compliant with healthcare infection control standards.
                        </div>
                      </div>
                    )}

                    {step.visualType === 'lms' && (
                      <div class="w-full h-full flex flex-col justify-between">
                        <div class="flex justify-between items-center border-b border-slate-50 pb-2">
                          <span class="text-xs font-bold text-primary uppercase tracking-wider">LMS Dashboard</span>
                          <span class="text-[10px] bg-[#C5A059]/10 text-[#C5A059] font-bold px-2 py-0.5 rounded">Portal</span>
                        </div>
                        
                        <div class="grid grid-cols-5 gap-3 my-auto items-center">
                          <div class="col-span-3 bg-slate-50 rounded-xl p-3 border border-slate-100 space-y-2">
                            <div class="h-2 w-12 bg-slate-200 rounded"></div>
                            <div class="space-y-1">
                              <div class="flex items-center justify-between">
                                <div class="h-1.5 w-16 bg-primary/40 rounded"></div>
                                <div class="h-1.5 w-4 bg-primary/60 rounded"></div>
                              </div>
                              <div class="w-full bg-slate-200 h-1 rounded-full overflow-hidden">
                                <div class="w-[85%] bg-primary h-full rounded-full"></div>
                              </div>
                            </div>
                            <div class="flex gap-1 justify-end">
                              <div class="h-3 w-6 bg-[#C5A059] rounded-[3px]"></div>
                              <div class="h-3 w-3 bg-slate-200 rounded-[3px]"></div>
                            </div>
                          </div>
                          
                          <div class="col-span-2 flex flex-col items-center">
                            <div class="relative w-14 h-14 flex items-center justify-center">
                              <svg class="w-full h-full transform -rotate-90">
                                <circle cx="28" cy="28" r="22" stroke="#f1f5f9" stroke-width="4" fill="transparent"/>
                                <circle cx="28" cy="28" r="22" stroke="#1A392A" stroke-width="4" fill="transparent" stroke-dasharray="138" stroke-dashoffset="0"/>
                              </svg>
                              <span class="absolute text-[10px] font-black text-primary">100%</span>
                            </div>
                            <span class="text-[8px] font-bold text-slate-400 uppercase mt-1">Training</span>
                          </div>
                        </div>
                        
                        <div class="text-[10px] text-slate-400 text-center font-medium border-t border-slate-50 pt-2">
                          Ensuring full traceability and accountability of laundry PIC.
                        </div>
                      </div>
                    )}

                    {step.visualType === 'reports' && (
                      <div class="w-full h-full flex flex-col justify-between">
                        <div class="flex justify-between items-center border-b border-slate-50 pb-2">
                          <span class="text-xs font-bold text-primary uppercase tracking-wider">Lab Results</span>
                          <span class="text-[10px] bg-blue-50 text-blue-700 font-semibold px-2 py-0.5 rounded">Quarterly</span>
                        </div>
                        
                        <div class="space-y-1.5 my-auto">
                          <div class="flex justify-between items-center bg-slate-50 px-3 py-1.5 rounded-lg border border-slate-100">
                            <span class="text-[10px] font-bold text-slate-600">Linen Swab Test</span>
                            <span class="text-[9px] bg-emerald-500 text-white font-bold px-2 py-0.5 rounded-full">Negative</span>
                          </div>
                          
                          <div class="flex justify-between items-center bg-slate-50 px-3 py-1.5 rounded-lg border border-slate-100">
                            <span class="text-[10px] font-bold text-slate-600">Liquid Waste</span>
                            <span class="text-[9px] bg-emerald-500 text-white font-bold px-2 py-0.5 rounded-full">Safe</span>
                          </div>
                          
                          <div class="flex justify-between items-center bg-slate-50 px-3 py-1.5 rounded-lg border border-slate-100">
                            <span class="text-[10px] font-bold text-slate-600">Water Quality</span>
                            <span class="text-[9px] bg-emerald-500 text-white font-bold px-2 py-0.5 rounded-full">Compliant</span>
                          </div>
                        </div>
                        
                        <div class="text-[9px] text-slate-400 text-center font-medium border-t border-slate-50 pt-2">
                          Environmental safety & sanitization test compliant.
                        </div>
                      </div>
                    )}

                    {step.visualType === 'stock' && (
                      <div class="w-full h-full flex flex-col justify-between">
                        <div class="flex justify-between items-center border-b border-slate-50 pb-2">
                          <span class="text-xs font-bold text-primary uppercase tracking-wider">Inventory Audit</span>
                          <span class="text-[10px] bg-amber-50 text-amber-700 font-semibold px-2 py-0.5 rounded">Live</span>
                        </div>
                        
                        <div class="flex items-center gap-4 my-auto">
                          <div class="flex-1 space-y-2">
                            <div class="flex items-center gap-1.5">
                              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                              <span class="text-[10px] font-bold text-slate-600">Monthly Opname: Done</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                              <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                              <span class="text-[10px] font-bold text-slate-600">Weekly Sampling: OK</span>
                            </div>
                          </div>
                          
                          <div class="w-16 h-16 rounded-full border-4 border-slate-100 flex flex-col items-center justify-center p-1 shrink-0 bg-slate-50 relative">
                            <span class="text-[12px] font-black text-primary">99.9%</span>
                            <span class="text-[7px] font-bold text-slate-400 uppercase tracking-widest leading-none mt-0.5">Accuracy</span>
                          </div>
                        </div>
                        
                        <div class="text-[10px] text-slate-400 text-center font-medium border-t border-slate-50 pt-2">
                          Routine reconciliation prevents linen loss across facilities.
                        </div>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

