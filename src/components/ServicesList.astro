<script>
  (function () {
    'use strict';
    
    function initServicesInteraction() {
      // DESKTOP TIMELINE SYSTEM
      const desktopButtons = document.querySelectorAll('.timeline-step-btn');
      const desktopCards = document.querySelectorAll('.service-detail-card');
      const progressLine = document.getElementById('timeline-progress-line');
      
      if (!desktopButtons.length || !desktopCards.length) return;

      function setDesktopActiveStep(index) {
        desktopButtons.forEach((btn, idx) => {
          const circle = btn.querySelector('.timeline-step-circle');
          const pulse = btn.querySelector('.timeline-step-pulse');
          const number = btn.querySelector('.timeline-step-number');
          const title = btn.querySelector('.timeline-step-title');
          
          if (idx === index) {
            btn.classList.add('active');
            if (circle) {
              circle.classList.add('bg-[#1A392A]', 'border-[#1A392A]', 'text-white', 'scale-110', 'shadow-md', 'shadow-primary/20');
              circle.classList.remove('bg-white', 'border-slate-200', 'text-slate-400');
            }
            if (pulse) pulse.classList.add('opacity-100');
            if (number) {
              number.classList.add('text-[#C5A059]');
              number.classList.remove('text-slate-400');
            }
            if (title) {
              title.classList.add('text-primary', 'font-extrabold');
              title.classList.remove('text-slate-500');
            }
          } else {
            btn.classList.remove('active');
            if (circle) {
              circle.classList.remove('bg-[#1A392A]', 'border-[#1A392A]', 'text-white', 'scale-110', 'shadow-md', 'shadow-primary/20');
              circle.classList.add('bg-white', 'border-slate-200', 'text-slate-400');
            }
            if (pulse) pulse.classList.remove('opacity-100');
            if (number) {
              number.classList.remove('text-[#C5A059]');
              number.classList.add('text-slate-400');
            }
            if (title) {
              title.classList.remove('text-primary', 'font-extrabold');
              title.classList.add('text-slate-500');
            }
          }
        });
        
        desktopCards.forEach((card, idx) => {
          if (idx === index) {
            card.classList.remove('hidden');
            card.classList.add('flex', 'flex-col', 'lg:flex-row', 'animate-fade-in-up');
          } else {
            card.classList.add('hidden');
            card.classList.remove('flex', 'flex-col', 'lg:flex-row', 'animate-fade-in-up');
          }
        });
        
        // Update progress bar width
        // Calculation: index / (total_steps - 1) * 90% (to offset width from first node left center to last node left center)
        // Let's make it simpler and scale perfectly from 0% to 90%
        if (progressLine) {
          const percentage = index * 18; // 0, 18, 36, 54, 72, 90 %
          progressLine.style.width = `${percentage}%`;
        }
      }
      
      desktopButtons.forEach((button) => {
        const index = parseInt(button.getAttribute('data-index') || '0', 10);
        
        button.addEventListener('click', () => {
          setDesktopActiveStep(index);
        });
        
        button.addEventListener('mouseenter', () => {
          setDesktopActiveStep(index);
        });
      });
      
      // Initialize desktop step 0
      setDesktopActiveStep(0);
      
      // MOBILE ACCORDION SYSTEM
      const mobileButtons = document.querySelectorAll('.mobile-accordion-btn');
      const mobilePanels = document.querySelectorAll('.mobile-accordion-panel');
      
      if (!mobileButtons.length || !mobilePanels.length) return;

      function toggleMobileAccordion(index) {
        mobilePanels.forEach((panel, idx) => {
          const btn = mobileButtons[idx];
          const chevron = btn.querySelector('.mobile-accordion-chevron');
          const circle = btn.querySelector('.mobile-step-circle');
          const card = btn.closest('.mobile-step-card');
          
          if (idx === index) {
            const isCurrentlyOpen = panel.classList.contains('grid-rows-[1fr]');
            
            if (isCurrentlyOpen) {
              panel.classList.remove('grid-rows-[1fr]');
              panel.classList.add('grid-rows-[0fr]');
              if (chevron) chevron.classList.remove('rotate-180', 'text-primary');
              if (circle) circle.classList.remove('bg-primary', 'text-white');
              if (card) card.classList.remove('border-[#C5A059]/40', 'shadow-md');
            } else {
              panel.classList.add('grid-rows-[1fr]');
              panel.classList.remove('grid-rows-[0fr]');
              if (chevron) chevron.classList.add('rotate-180', 'text-primary');
              if (circle) circle.classList.add('bg-primary', 'text-white');
              if (card) card.classList.add('border-[#C5A059]/40', 'shadow-md');
            }
          } else {
            panel.classList.remove('grid-rows-[1fr]');
            panel.classList.add('grid-rows-[0fr]');
            if (chevron) chevron.classList.remove('rotate-180', 'text-primary');
            if (circle) circle.classList.remove('bg-primary', 'text-white');
            if (card) card.classList.remove('border-[#C5A059]/40', 'shadow-md');
          }
        });
      }
      
      mobileButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const index = parseInt(btn.getAttribute('data-index') || '0', 10);
          toggleMobileAccordion(index);
        });
      });
      
      // Expand the first accordion by default on mobile
      toggleMobileAccordion(0);
    }
    
    document.addEventListener('DOMContentLoaded', initServicesInteraction);
    // Execute for Astro Page Swap / Transitions
    document.addEventListener('astro:after-swap', initServicesInteraction);
    document.addEventListener('astro:page-load', initServicesInteraction);
  })();
</script>

