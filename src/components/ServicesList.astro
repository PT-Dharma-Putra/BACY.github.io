---
const lang = Astro.currentLocale || 'en';

const t = {
  en: {
    title: "OUR SERVICES",
    services: [
      {
        desc: "Linen parstock (optional):\n5 parstock for ER, OR, and baby units\n3 parstock for ICU, Polyclinic, and Outpatient units",
        icon: "layers",
        direction: "up"
      },
      {
        desc: "Pick-up and delivery service for dirty and clean linen with a one-day service system, applying the 3T principles (On quality / On time / On budget)",
        icon: "local_shipping",
        direction: "down"
      },
      {
        desc: "Linen quality standards:\nclean, odorless, and hygienic",
        icon: "verified_user",
        direction: "up"
      },
      {
        desc: "LMS training system for Hospital laundry PICs/users",
        icon: "co_present",
        direction: "down"
      },
      {
        desc: "Quarterly reporting:\n- Linen swab (swab test results)\n- Liquid waste test results\n- Water quality standard results",
        icon: "analytics",
        direction: "up"
      },
      {
        desc: "Routine stock opname every month and random stock opname every week",
        icon: "inventory",
        direction: "down"
      }
    ]
  },
  id: {
    title: "LAYANAN KAMI",
    services: [
      {
        desc: "Parstock linen (optional):\n5 parstock untuk unit VK, OK, dan bayi\n3 parstock untuk unit ICU, Poliklinik, dan Rawat Jalan",
        icon: "layers",
        direction: "up"
      },
      {
        desc: "Pelayanan antar jemput Linen kotor dan bersih (delivery service) dengan system one day service, dengan prinsip 3T (Tepat mutu/waktu/budget)",
        icon: "local_shipping",
        direction: "down"
      },
      {
        desc: "Standar kualitas linen :\nbersih, tidak berbau dan hygiene",
        icon: "verified_user",
        direction: "up"
      },
      {
        desc: "Training system LMS untuk PIC laundry/user Rumah Sakit",
        icon: "co_present",
        direction: "down"
      },
      {
        desc: "Memberikan laporan per 3 bulan\n- Swab linen (hasil uji usap)\n- Hasil uji limbah cair\n- Hasil baku mutu air",
        icon: "analytics",
        direction: "up"
      },
      {
        desc: "Stock opname rutin setiap bulan dan random per minggu",
        icon: "inventory",
        direction: "down"
      }
    ]
  }
}[lang];

const services = t.services;
---

<section class="py-24 bg-white overflow-hidden" id="services">
  <div class="max-w-7xl mx-auto px-4 lg:px-6">
    <div class="flex items-center gap-6 mb-16 md:mb-8">
      <h2 class="font-display text-4xl md:text-5xl font-bold text-primary tracking-widest whitespace-nowrap">
        {t.title}
      </h2>
      <div class="h-[3px] w-full bg-primary"></div>
    </div>

    <!-- Desktop Layout (Staggered Timeline) -->
    <div class="hidden md:flex flex-row justify-between items-center relative w-full pt-8">
      <!-- Horizontal Connecting Line -->
      <div class="absolute top-1/2 -translate-y-1/2 left-0 w-full h-[3px] bg-primary -z-10"></div>
      
      {
        services.map((step) => (
          <div class="flex-1 flex flex-col items-center text-center group">
            <!-- Top Text -->
            <div class="h-32 lg:h-36 flex items-end justify-center pb-6 px-1 w-full">
              <p class={`text-[10px] lg:text-[11px] xl:text-xs font-semibold text-[#2f3e36] whitespace-pre-line leading-relaxed ${step.direction === 'up' ? 'opacity-100' : 'opacity-0'}`}>
                {step.desc}
              </p>
            </div>
            
            <!-- Circle with Icon -->
            <div class="relative w-20 h-20 lg:w-24 lg:h-24 rounded-full bg-primary text-white flex items-center justify-center shadow-lg transition-transform duration-500 z-10 border-[6px] border-white group-hover:bg-[#1f422e] group-hover:scale-105">
              <!-- Arrow Up -->
              <div class={`absolute flex flex-col items-center -top-[20px] lg:-top-[22px] transition-opacity duration-500 ${step.direction === 'up' ? '' : 'hidden'}`}>
                <div class="w-0 h-0 border-l-[10px] border-r-[10px] border-transparent border-b-[14px] border-b-primary group-hover:border-b-[#1f422e] transition-colors duration-500"></div>
                <div class="w-3 h-2 bg-primary group-hover:bg-[#1f422e] transition-colors duration-500 -mt-[1px]"></div>
              </div>
              
              <!-- Arrow Down -->
              <div class={`absolute flex flex-col items-center -bottom-[20px] lg:-bottom-[22px] transition-opacity duration-500 ${step.direction === 'down' ? '' : 'hidden'}`}>
                <div class="w-3 h-2 bg-primary group-hover:bg-[#1f422e] transition-colors duration-500 -mb-[1px]"></div>
                <div class="w-0 h-0 border-l-[10px] border-r-[10px] border-transparent border-t-[14px] border-t-primary group-hover:border-t-[#1f422e] transition-colors duration-500"></div>
              </div>
              
              <span class="material-icons-outlined text-3xl lg:text-4xl">{step.icon}</span>
            </div>

            <!-- Bottom Text -->
            <div class="h-32 lg:h-36 flex items-start justify-center pt-6 px-1 w-full">
              <p class={`text-[10px] lg:text-[11px] xl:text-xs font-semibold text-[#2f3e36] whitespace-pre-line leading-relaxed ${step.direction === 'down' ? 'opacity-100' : 'opacity-0'}`}>
                {step.desc}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Mobile Layout (Vertical Timeline) -->
    <div class="md:hidden flex flex-col gap-10 relative py-8 pl-4 pr-2">
      <!-- Vertical Connecting Line -->
      <div class="absolute top-0 bottom-0 left-[56px] w-[3px] bg-primary -z-10"></div>
      
      {
        services.map((step) => (
          <div class="flex items-center gap-6 group relative">
            <div class="relative w-20 h-20 shrink-0 rounded-full bg-primary text-white flex items-center justify-center shadow-lg border-[6px] border-white z-10 group-hover:bg-[#1f422e] transition-colors duration-300">
              <!-- Arrow pointing right to the text -->
              <div class="absolute flex items-center -right-[20px]">
                <div class="h-3 w-2 bg-primary group-hover:bg-[#1f422e] transition-colors duration-300 -mr-[1px]"></div>
                <div class="w-0 h-0 border-t-[10px] border-b-[10px] border-transparent border-l-[14px] border-l-primary group-hover:border-l-[#1f422e] transition-colors duration-300"></div>
              </div>
              
              <span class="material-icons-outlined text-3xl">{step.icon}</span>
            </div>
            
            <div class="flex-1 py-2 bg-white/80 backdrop-blur-sm rounded-lg">
              <p class="text-xs sm:text-sm font-semibold text-[#2f3e36] whitespace-pre-line leading-relaxed">
                {step.desc}
              </p>
            </div>
          </div>
        ))
      }
    </div>

  </div>
</section>
