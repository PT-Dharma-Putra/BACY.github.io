    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  :global(.animate-fade-in-up) {
    animation: fadeInUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
  }
</style>
