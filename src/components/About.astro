---
const lang = Astro.currentLocale || 'en';

const t = {
  en: {
    eyebrow: "About Us",
    titleHtml: "Dedicated to Patient <span class='text-primary italic'>Hygiene</span> and <span class='text-primary italic'>Safety</span>",
    p1: "PT BACY was established with a passion to provide the best solutions for linen management in healthcare facilities.",
    p2: "We understand that clean linen is not just about comfort, but a crucial part of infection prevention and patient safety.",
    p3: "By adopting international standards and the latest technology, we deliver services that are not only efficient but also guarantee high hygiene standards. Every process is designed to support hospital and clinic operations so they can focus entirely on patient care.",
    p4: "We are committed to continuous innovation and becoming a trusted partner for the healthcare industry in Indonesia, providing clean, safe, and high-quality linen every day.",
    badgeTitle: "Global Standard",
    badgeSub: "Guaranteed Quality"
  },
  id: {
    eyebrow: "About Us",
    titleHtml: "Dedikasi untuk <span class='text-primary italic'>Higienitas</span> dan <span class='text-primary italic'>Keselamatan</span> Pasien",
    p1: "PT BACY didirikan dengan semangat untuk memberikan solusi terbaik bagi pengelolaan linen di fasilitas kesehatan.",
    p2: "Kami memahami bahwa kebersihan linen bukan sekadar kenyamanan, melainkan bagian krusial dari pencegahan infeksi dan keselamatan pasien.",
    p3: "Dengan mengadopsi standar internasional dan teknologi terkini, kami menghadirkan layanan yang tidak hanya efisien tetapi juga menjamin higienitas tinggi. Setiap proses kami dirancang untuk mendukung operasional rumah sakit dan klinik agar dapat fokus sepenuhnya pada perawatan pasien.",
    p4: "Kami berkomitmen untuk terus berinovasi dan menjadi mitra terpercaya bagi dunia kesehatan di Indonesia, menghadirkan linen yang bersih, aman, dan berkualitas tinggi setiap harinya.",
    badgeTitle: "Standar Global",
    badgeSub: "Kualitas Terjamin"
  }
}[lang];
---

<section id="about" class="py-24 lg:py-32 bg-white overflow-hidden relative border-b border-slate-50">
  <!-- Atmospheric Background -->
  <div class="absolute inset-0 z-0 opacity-10 pointer-events-none">
    <div
      class="absolute right-0 top-0 w-[600px] h-[600px] bg-[radial-gradient(circle_at_center,rgba(228,34,46,0.08)_0%,transparent_70%)]"
    >
    </div>
    <div
      class="absolute left-0 bottom-0 w-[600px] h-[600px] bg-[radial-gradient(circle_at_center,rgba(228,34,46,0.08)_0%,transparent_70%)]"
    >
    </div>
    <div
      class="absolute inset-0 bg-[radial-gradient(#e4222e10_1.5px,transparent_1.5px)] [background-size:32px_32px] opacity-20"
    >
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <!-- Images Grid -->
      <div class="grid grid-cols-2 gap-4 lg:gap-6 relative group">
        <div class="absolute inset-0 bg-primary/5 rounded-3xl -m-6 transform -rotate-3 transition-transform duration-500 group-hover:rotate-0 z-0"></div>
        
        <div class="space-y-4 lg:space-y-6 relative z-10">
          <div class="rounded-2xl overflow-hidden shadow-2xl aspect-square border-4 border-white">
            <img
              src="/images/about.png"
              alt="Healthcare Laundry Facility"
              class="w-full h-full object-cover hover:scale-110 transition-transform duration-700"
            />
          </div>
          <div class="rounded-2xl overflow-hidden shadow-2xl aspect-[4/3] border-4 border-white">
            <img
              src="/images/about2.png"
              alt="Medical Linen"
              class="w-full h-full object-cover hover:scale-110 transition-transform duration-700"
            />
          </div>
        </div>
        <div class="mt-4 md:mt-12 relative z-10">
          <div class="rounded-2xl overflow-hidden shadow-2xl aspect-[3/4] border-4 border-white">
            <img
              src="/images/about3.jpeg"
              alt="Sterilized Equipment"
              class="w-full h-full object-cover hover:scale-110 transition-transform duration-700"
            />
          </div>
        </div>
      </div>

      <!-- Content -->
      <div class="flex flex-col pl-0 lg:pl-8">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/5 text-primary text-sm font-bold tracking-widest uppercase w-fit mb-6 shadow-sm border border-primary/10">
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
          {t.eyebrow}
        </div>
        
        <h2
          class="font-display text-4xl md:text-5xl lg:text-5xl font-bold text-slate-900 mb-8 leading-[1.2]"
          set:html={t.titleHtml}
        >
        </h2>

        <div class="space-y-6 text-slate-600 leading-relaxed text-lg font-light">
          <p class="text-xl text-slate-800 font-medium pl-6 border-l-4 border-primary/40 relative">
            {t.p1}
          </p>
          <p>
            {t.p2}
          </p>
          <p>
            {t.p3}
          </p>
          <p>
            {t.p4}
          </p>
        </div>
        
        <div class="mt-12 flex items-center gap-6 pt-8 border-t border-slate-100">
           <div class="flex items-center gap-4">
              <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center text-primary">
                 <span class="material-icons-outlined text-3xl">verified</span>
              </div>
              <div>
                 <p class="font-bold text-slate-900 text-xl">{t.badgeTitle}</p>
                 <p class="text-slate-500 text-sm">{t.badgeSub}</p>
              </div>
           </div>
        </div>
      </div>
    </div>
  </div>
</section>
