---
// Navbar.astro - Elegant & Professional Navigation
const lang = Astro.currentLocale || 'en';
const basePath = lang === 'id' ? '/id' : '';

const t = {
  en: {
    home: "Home",
    about: "About Us",
    services: "Our Services",
    technology: "Technology",
    certificates: "Certificates",
    contact: "Contact Us",
    reachOut: "Reach Out To Us",
    rfid: "Integrated RFID",
    lms: "Laundry Management System",
    modernMachine: "Modern Machinery"
  },
  id: {
    home: "Beranda",
    about: "Tentang Kami",
    services: "Layanan Kami",
    technology: "Teknologi",
    certificates: "Sertifikat",
    contact: "Hubungi Kami",
    reachOut: "Hubungi Kami",
    rfid: "Terintegrasi RFID",
    lms: "Laundry Management System",
    modernMachine: "Mesin Modern"
  }
}[lang];
---

<nav
  class="fixed top-0 left-0 w-full z-50 transition-all duration-500 ease-in-out py-5 bg-transparent"
  id="main-nav"
>
  <div class="max-w-7xl mx-auto px-6 flex justify-between items-center relative z-50">
    
    <!-- Logo -->
    <div class="flex items-center gap-3">
      <a href="/#home" class="flex items-center group transition-transform duration-500 hover:scale-105">
        <img
          src="/images/logo_bacy.png"
          alt="PT BACY Logo"
          class="h-10 sm:h-12 md:h-14 lg:h-16 w-auto object-contain drop-shadow-[0_2px_10px_rgba(255,255,255,0.2)]"
          id="nav-logo"
        />
      </a>
    </div>

    <!-- Desktop Menu -->
    <div class="hidden md:flex items-center gap-10">
      <a
        href={`${basePath}/#home`}
        class="nav-link relative text-[0.8rem] font-medium text-white/80 hover:text-white transition-colors uppercase tracking-[0.15em] group py-2"
      >
        {t.home}
        <span class="nav-indicator absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-[2px] bg-gradient-to-r from-transparent via-[#C5A059] to-transparent transition-all duration-300 group-hover:w-full opacity-0 group-hover:opacity-100" />
      </a>
      
      <a
        href={`${basePath}/#about`}
        class="nav-link relative text-[0.8rem] font-medium text-white/80 hover:text-white transition-colors uppercase tracking-[0.15em] group py-2"
      >
        {t.about}
        <span class="nav-indicator absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-[2px] bg-gradient-to-r from-transparent via-[#C5A059] to-transparent transition-all duration-300 group-hover:w-full opacity-0 group-hover:opacity-100" />
      </a>

      <!-- Technology Dropdown -->
      <div class="relative group/dropdown py-2">
        <button 
          id="tech-dropdown-btn"
          class="text-[0.8rem] font-medium text-white/80 hover:text-white transition-colors uppercase tracking-[0.15em] flex items-center gap-1.5 focus:outline-none"
        >
          {t.technology}
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 transition-transform duration-300 group-hover/dropdown:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
          <span class="nav-indicator absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-[2px] bg-gradient-to-r from-transparent via-[#C5A059] to-transparent transition-all duration-300 group-hover/dropdown:w-full opacity-0 group-hover/dropdown:opacity-100" />
        </button>
        <!-- Dropdown Menu -->
        <div class="absolute top-full left-1/2 -translate-x-1/2 mt-2 w-64 bg-[#080e0a] border border-white/10 rounded-xl shadow-2xl py-3 opacity-0 invisible group-hover/dropdown:opacity-100 group-hover/dropdown:visible transition-all duration-300 transform scale-95 origin-top z-50 backdrop-blur-md">
          <a href={`${basePath}/#rfid-system`} class="nav-link block px-5 py-2.5 text-xs text-white/80 hover:text-white hover:bg-white/5 transition-colors uppercase tracking-wider font-semibold">
            {t.rfid}
          </a>
          <a href={`${basePath}/#lms-process`} class="nav-link block px-5 py-2.5 text-xs text-white/80 hover:text-white hover:bg-white/5 transition-colors uppercase tracking-wider font-semibold">
            {t.lms}
          </a>
          <a href={`${basePath}/#technology-support`} class="nav-link block px-5 py-2.5 text-xs text-white/80 hover:text-white hover:bg-white/5 transition-colors uppercase tracking-wider font-semibold">
            {t.modernMachine}
          </a>
        </div>
      </div>

      <a
        href={`${basePath}/#services`}
        class="nav-link relative text-[0.8rem] font-medium text-white/80 hover:text-white transition-colors uppercase tracking-[0.15em] group py-2"
      >
        {t.services}
        <span class="nav-indicator absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-[2px] bg-gradient-to-r from-transparent via-[#C5A059] to-transparent transition-all duration-300 group-hover:w-full opacity-0 group-hover:opacity-100" />
      </a>


      <a
        href={`${basePath}/#certificates`}
        class="nav-link relative text-[0.8rem] font-medium text-white/80 hover:text-white transition-colors uppercase tracking-[0.15em] group py-2"
      >
        {t.certificates}
        <span class="nav-indicator absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-[2px] bg-gradient-to-r from-transparent via-[#C5A059] to-transparent transition-all duration-300 group-hover:w-full opacity-0 group-hover:opacity-100" />
      </a>
      
      <!-- Language Switcher Desktop -->
      <div class="flex items-center gap-2 text-[0.7rem] font-bold uppercase tracking-widest text-white/70 ml-2 border border-white/10 rounded-full px-3 py-1.5 backdrop-blur-sm">
        <a href="/" class={`hover:text-white transition-colors ${lang === 'en' ? 'text-[#C5A059]' : ''}`}>EN</a>
        <span class="text-white/20">|</span>
        <a href="/id/" class={`hover:text-white transition-colors ${lang === 'id' ? 'text-[#C5A059]' : ''}`}>ID</a>
      </div>

      <!-- Contact Button -->
      <a
        href="https://wa.me/6281128507788"
        target="_blank"
        class="relative inline-flex items-center justify-center px-7 py-2.5 text-[0.75rem] font-bold text-[#080e0a] uppercase tracking-widest bg-gradient-to-r from-[#C5A059] to-[#E5C27B] rounded-full overflow-hidden transition-all duration-300 hover:shadow-[0_0_20px_rgba(197,160,89,0.4)] hover:-translate-y-0.5 group"
      >
        <span class="absolute inset-0 w-full h-full bg-gradient-to-r from-white/0 via-white/30 to-white/0 -translate-x-full group-hover:animate-shimmer"></span>
        <span class="relative flex items-center gap-2">
          {t.contact}
        </span>
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button id="menu-toggle" class="p-2 md:hidden group z-50">
      <div class="w-7 h-5 flex flex-col justify-between items-end">
        <span class="w-full h-[2px] bg-white rounded-full transition-all duration-300 group-hover:w-3/4"></span>
        <span class="w-3/4 h-[2px] bg-white rounded-full transition-all duration-300 group-hover:w-full"></span>
        <span class="w-full h-[2px] bg-white rounded-full transition-all duration-300 group-hover:w-1/2"></span>
      </div>
    </button>
  </div>

  <!-- Mobile Menu Overlay -->
  <div
    id="mobile-menu"
    class="fixed inset-0 bg-[#080e0a]/95 backdrop-blur-xl z-[60] transform translate-x-full invisible pointer-events-none transition-all duration-700 ease-[cubic-bezier(0.85,0,0.15,1)] md:hidden flex flex-col h-screen"
  >
    <!-- Mobile Header -->
    <div class="flex justify-between items-center px-6 py-6 border-b border-white/5">
      <a href="/#home" class="flex items-center">
        <img
          src="/images/logo_bacy.png"
          alt="PT BACY Logo"
          class="h-12 w-auto object-contain drop-shadow-[0_2px_10px_rgba(255,255,255,0.2)]"
        />
      </a>
      <button
        id="close-menu"
        class="p-2 text-white/70 hover:text-[#C5A059] transition-colors"
      >
        <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Mobile Scrollable Content -->
    <div class="flex-1 overflow-y-auto px-8 py-12 flex flex-col justify-between relative">
      <!-- Decorative element -->
      <div class="absolute top-0 right-0 w-64 h-64 bg-[#C5A059]/5 rounded-full blur-[80px] pointer-events-none"></div>
      
      <div class="space-y-6 relative z-10">
        <a
          href={`${basePath}/#home`}
          class="mobile-link block group translate-y-8 opacity-0 transition-all duration-700"
          style="transition-delay: 0ms;"
        >
          <span class="mobile-link-text flex items-center gap-4 text-3xl font-display font-light text-white/80 group-hover:text-white transition-colors">
            <span class="mobile-link-indicator text-sm font-normal text-[#C5A059] opacity-0 group-hover:opacity-100 transition-opacity w-4">
              &rarr;
            </span>
            {t.home}
          </span>
        </a>

        <a
          href={`${basePath}/#about`}
          class="mobile-link block group translate-y-8 opacity-0 transition-all duration-700"
          style="transition-delay: 75ms;"
        >
          <span class="mobile-link-text flex items-center gap-4 text-3xl font-display font-light text-white/80 group-hover:text-white transition-colors">
            <span class="mobile-link-indicator text-sm font-normal text-[#C5A059] opacity-0 group-hover:opacity-100 transition-opacity w-4">
              &rarr;
            </span>
            {t.about}
          </span>
        </a>

        <!-- Mobile Technology Accordion -->
        <div 
          class="mobile-link block group translate-y-8 opacity-0 transition-all duration-700"
          style="transition-delay: 150ms;"
        >
          <button 
            id="mobile-tech-toggle" 
            class="w-full flex items-center justify-between text-3xl font-display font-light text-white/80 hover:text-white transition-colors focus:outline-none py-1"
          >
            <span class="mobile-link-text-container flex items-center gap-4 text-left">
              <span class="mobile-link-indicator mobile-link-indicator-main text-sm font-normal text-[#C5A059] opacity-0 transition-opacity w-4">
                &rarr;
              </span>
              {t.technology}
            </span>
            <svg id="mobile-tech-icon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          
          <!-- Mobile Submenu -->
          <div id="mobile-tech-submenu" class="max-h-0 overflow-hidden transition-all duration-500 ease-in-out pl-8 space-y-4 mt-2">
            <a href={`${basePath}/#rfid-system`} class="mobile-link mobile-sublink block text-lg font-light text-white/60 hover:text-white transition-colors py-1">
              {t.rfid}
            </a>
            <a href={`${basePath}/#lms-process`} class="mobile-link mobile-sublink block text-lg font-light text-white/60 hover:text-white transition-colors py-1">
              {t.lms}
            </a>
            <a href={`${basePath}/#technology-support`} class="mobile-link mobile-sublink block text-lg font-light text-white/60 hover:text-white transition-colors py-1">
              {t.modernMachine}
            </a>
          </div>
        </div>

        <a
          href={`${basePath}/#services`}
          class="mobile-link block group translate-y-8 opacity-0 transition-all duration-700"
          style="transition-delay: 225ms;"
        >
          <span class="mobile-link-text flex items-center gap-4 text-3xl font-display font-light text-white/80 group-hover:text-white transition-colors">
            <span class="mobile-link-indicator text-sm font-normal text-[#C5A059] opacity-0 group-hover:opacity-100 transition-opacity w-4">
              &rarr;
            </span>
            {t.services}
          </span>
        </a>

        <a
          href={`${basePath}/#certificates`}
          class="mobile-link block group translate-y-8 opacity-0 transition-all duration-700"
          style="transition-delay: 300ms;"
        >
          <span class="mobile-link-text flex items-center gap-4 text-3xl font-display font-light text-white/80 group-hover:text-white transition-colors">
            <span class="mobile-link-indicator text-sm font-normal text-[#C5A059] opacity-0 group-hover:opacity-100 transition-opacity w-4">
              &rarr;
            </span>
            {t.certificates}
          </span>
        </a>
      </div>

      <div class="pb-10 translate-y-8 opacity-0 transition-all duration-700 delay-[500ms] relative z-10" id="mobile-footer">
        <div class="w-full h-px bg-white/5 mb-8"></div>
        <div class="flex flex-col gap-4">
          <!-- Language Switcher Mobile -->
          <div class="flex items-center gap-4 text-sm font-bold uppercase tracking-widest text-white/70 mb-2">
            <a href="/" class={`hover:text-white transition-colors ${lang === 'en' ? 'text-[#C5A059]' : ''}`}>EN (English)</a>
            <span class="text-white/20">|</span>
            <a href="/id/" class={`hover:text-white transition-colors ${lang === 'id' ? 'text-[#C5A059]' : ''}`}>ID (Indonesia)</a>
          </div>

          <p class="text-[10px] uppercase tracking-[0.2em] text-white/40 font-bold">
            {t.reachOut}
          </p>
          <a
            href="https://wa.me/6281128507788"
            target="_blank"
            class="flex items-center gap-4 text-white font-medium text-lg group hover:text-[#C5A059] transition-colors"
          >
            <div class="w-12 h-12 bg-gradient-to-br from-[#C5A059] to-[#E5C27B] flex items-center justify-center rounded-full text-[#080e0a] group-hover:scale-110 transition-transform shadow-[0_0_15px_rgba(197,160,89,0.3)]">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641a4.483 4.483 0 01-.923 1.785A5.969 5.969 0 006 21c1.282 0 2.47-.402 3.445-1.087.81.22 1.668.337 2.555.337z"/>
              </svg>
            </div>
            0811-2700-5688
          </a>
        </div>
      </div>
    </div>
  </div>

  <style>
    @keyframes shimmer {
      100% { transform: translateX(100%); }
    }
    .animate-shimmer {
      animation: shimmer 2s infinite;
    }
    .nav-link.active {
      color: white;
    }
    .nav-link.active .nav-indicator {
      width: 100%;
      opacity: 1;
    }
    #tech-dropdown-btn.active {
      color: white;
    }
    #tech-dropdown-btn.active .nav-indicator {
      width: 100%;
      opacity: 1;
    }
  </style>

  <script>
    const menuToggle = document.getElementById("menu-toggle");
    const closeMenu = document.getElementById("close-menu");
    const mobileMenu = document.getElementById("mobile-menu");
    const mobileLinks = document.querySelectorAll(".mobile-link");
    const mobileFooter = document.getElementById("mobile-footer");
    const mainNav = document.getElementById("main-nav");

    // Scroll Behavior
    window.addEventListener("scroll", () => {
      if (window.scrollY > 50) {
        // Scrolled state: Dark background with blur, smaller padding, thin border
        mainNav?.classList.add("py-3", "bg-[#080e0a]/90", "backdrop-blur-lg", "border-b", "border-white/5", "shadow-[0_4px_30px_rgba(0,0,0,0.3)]");
        mainNav?.classList.remove("py-5", "bg-transparent");
      } else {
        // Top state: Transparent, larger padding
        mainNav?.classList.remove("py-3", "bg-[#080e0a]/90", "backdrop-blur-lg", "border-b", "border-white/5", "shadow-[0_4px_30px_rgba(0,0,0,0.3)]");
        mainNav?.classList.add("py-5", "bg-transparent");
      }
    });

    // Handle Mobile Menu
    const toggleMenu = (open: boolean) => {
      if (open) {
        mobileMenu?.classList.remove("translate-x-full", "invisible", "pointer-events-none");
        document.body.style.overflow = "hidden"; // Prevent scrolling

        // Animate items in stagger
        setTimeout(() => {
          mobileLinks.forEach((link) => {
            link.classList.remove("translate-y-8", "opacity-0");
          });
          mobileFooter?.classList.remove("translate-y-8", "opacity-0");
        }, 50);
      } else {
        mobileMenu?.classList.add("translate-x-full");
        document.body.style.overflow = "";

        // Reset animation state after transition
        setTimeout(() => {
          if (!mobileMenu?.classList.contains("translate-x-full")) return;
          mobileMenu?.classList.add("invisible", "pointer-events-none");
          mobileLinks.forEach((link) => {
            link.classList.add("translate-y-8", "opacity-0");
          });
          mobileFooter?.classList.add("translate-y-8", "opacity-0");
        }, 700);
      }
    };

    menuToggle?.addEventListener("click", () => toggleMenu(true));
    closeMenu?.addEventListener("click", () => toggleMenu(false));

    mobileLinks.forEach((link) => {
      // Don't close if it is the accordion trigger
      if (link.id === "mobile-tech-toggle" || link.querySelector('#mobile-tech-toggle')) return;
      link.addEventListener("click", () => toggleMenu(false));
    });

    // Mobile Accordion Toggle
    const mobileTechToggle = document.getElementById("mobile-tech-toggle");
    const mobileTechSubmenu = document.getElementById("mobile-tech-submenu");
    const mobileTechIcon = document.getElementById("mobile-tech-icon");

    if (mobileTechToggle && mobileTechSubmenu && mobileTechIcon) {
      mobileTechToggle.addEventListener("click", (e) => {
        e.stopPropagation();
        const isOpen = mobileTechSubmenu.style.maxHeight && mobileTechSubmenu.style.maxHeight !== "0px";
        if (isOpen) {
          mobileTechSubmenu.style.maxHeight = "0px";
          mobileTechIcon.classList.remove("rotate-180");
        } else {
          mobileTechSubmenu.style.maxHeight = `${mobileTechSubmenu.scrollHeight}px`;
          mobileTechIcon.classList.add("rotate-180");
        }
      });
    }

    const mobileSublinks = document.querySelectorAll(".mobile-sublink");
    mobileSublinks.forEach((sublink) => {
      sublink.addEventListener("click", () => {
        toggleMenu(false);
        if (mobileTechSubmenu && mobileTechIcon) {
          mobileTechSubmenu.style.maxHeight = "0px";
          mobileTechIcon.classList.remove("rotate-180");
        }
      });
    });

    // Active Link Scroll Spy
    const desktopNavLinks = document.querySelectorAll('.nav-link');
    const mobileNavLinks = document.querySelectorAll('.mobile-link');

    const observerOptions = {
      root: null,
      rootMargin: '-50% 0px -50% 0px',
      threshold: 0
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          if (!id) return;
          
          desktopNavLinks.forEach(link => {
            link.classList.remove('active');
            const href = link.getAttribute('href');
            if (href === `/#${id}` || href === `/id/#${id}`) {
              link.classList.add('active');
            }
          });
          
          // Highlight main nav buttons and drop downs
          const techSections = ['rfid-system', 'lms-process', 'technology-support'];
          const techButton = document.querySelector('#tech-dropdown-btn');
          if (techButton) {
            if (techSections.includes(id)) {
              techButton.classList.add('active');
            } else {
              techButton.classList.remove('active');
            }
          }

          mobileNavLinks.forEach(link => {
            const textSpan = link.querySelector('.mobile-link-text');
            const indicator = link.querySelector('.mobile-link-indicator');
            const href = link.getAttribute('href');
            if (href === `/#${id}` || href === `/id/#${id}`) {
              textSpan?.classList.add('text-white');
              textSpan?.classList.remove('text-white/80');
              indicator?.classList.add('opacity-100');
              indicator?.classList.remove('opacity-0');
            } else {
              textSpan?.classList.remove('text-white');
              textSpan?.classList.add('text-white/80');
              indicator?.classList.remove('opacity-100');
              indicator?.classList.add('opacity-0');
            }
          });

          // Highlight mobile technology toggle if any child section is active
          const mobileTechToggleText = document.querySelector('#mobile-tech-toggle .mobile-link-text-container');
          const mobileTechIndicator = document.querySelector('#mobile-tech-toggle .mobile-link-indicator-main');
          if (techSections.includes(id)) {
            mobileTechToggleText?.classList.add('text-white');
            mobileTechToggleText?.classList.remove('text-white/80');
            mobileTechIndicator?.classList.add('opacity-100');
            mobileTechIndicator?.classList.remove('opacity-0');
          } else {
            mobileTechToggleText?.classList.remove('text-white');
            mobileTechToggleText?.classList.add('text-white/80');
            mobileTechIndicator?.classList.remove('opacity-100');
            mobileTechIndicator?.classList.add('opacity-0');
          }
        }
      });
    }, observerOptions);

    document.querySelectorAll('section[id]').forEach((section) => {
      observer.observe(section);
    });
  </script>
</nav>

