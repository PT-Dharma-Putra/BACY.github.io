---
const lang = Astro.currentLocale || 'en';

const t = {
  en: {
    title: "Testimonials",
    list: [
      {
        name: "RS HERMINA",
        logo: "/images/Testimoni.png",
        rating: 5.0,
        quote: '"PT BACY\'s linen hygiene standards consistently meet health regulations, giving us absolute peace of mind in patient care."'
      },
      {
        name: "RS PREMIER",
        logo: "/images/Testimoni.png",
        rating: 5.0,
        quote: '"Prompt delivery and reliable pickup from PT BACY ensure our team always has sterile linens ready. Highly professional partner."'
      },
      {
        name: "SILOAM HOSPITALS",
        logo: "/images/Testimoni.png",
        rating: 5.0,
        quote: '"Linens from PT BACY are clinically hygienic and exceptionally soft, greatly enhancing the comfort of our inpatient suites."'
      },
      {
        name: "MAYAPADA HOSPITAL",
        logo: "/images/Testimoni.png",
        rating: 5.0,
        quote: '"PT BACY\'s ecological compliance and waste management align perfectly with our green hospital initiative."'
      }
    ]
  },
  id: {
    title: "Testimoni",
    list: [
      {
        name: "RS HERMINA",
        logo: "/images/Testimoni.png",
        rating: 5.0,
        quote: '"Standar higienitas linen dari PT BACY selalu terjaga dan memenuhi regulasi, memberikan kami ketenangan dalam melayani pasien."'
      },
      {
        name: "RS PREMIER",
        logo: "/images/Testimoni.png",
        rating: 5.0,
        quote: '"Pengiriman cepat dan penjemputan andal dari PT BACY memastikan tim kami selalu memiliki linen steril siap pakai. Sangat profesional."'
      },
      {
        name: "SILOAM HOSPITALS",
        logo: "/images/Testimoni.png",
        rating: 5.0,
        quote: '"Linen dari PT BACY tidak hanya higienis secara klinis tetapi juga sangat lembut, meningkatkan kenyamanan pasien rawat inap kami."'
      },
      {
        name: "MAYAPADA HOSPITAL",
        logo: "/images/Testimoni.png",
        rating: 5.0,
        quote: '"Pengelolaan limbah dan kepatuhan ekologis PT BACY sangat selaras dengan inisiatif green hospital kami."'
      }
    ]
  }
}[lang];

const testimonials = t.list;
---
<section class="py-24 bg-[#fcfdfc] overflow-hidden" id="testimonials-section">
  <div class="max-w-7xl mx-auto">
    <!-- Header with Dark Green Bar -->
    <div class="bg-[#0b3d1b] py-6 px-10 flex items-center justify-between mb-20">
      <div class="text-white text-3xl md:text-5xl font-light tracking-[-0.1em] opacity-80">{"»»»»»»»»»»"}</div>
      <h2 class="font-display text-3xl md:text-5xl font-bold text-white uppercase tracking-[0.3em] text-center">
        {t.title}
      </h2>
      <div class="text-white text-3xl md:text-5xl font-light tracking-[-0.1em] opacity-80">{"««««««««««"}</div>
    </div>

    <!-- Carousel Wrapper with Side Buttons -->
    <div class="relative px-4 md:px-12 group/carousel">
      <!-- Prev Button -->
      <button 
        id="testimonial-prev"
        class="absolute left-2 md:left-0 top-1/2 -translate-y-1/2 z-20 w-12 h-12 rounded-full bg-[#0b3d1b] hover:bg-[#155a2d] text-white flex items-center justify-center shadow-lg transition-all duration-300 disabled:opacity-30 disabled:cursor-not-allowed"
        aria-label="Previous testimonial"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Embla Viewport -->
      <div class="embla overflow-hidden" id="testimonial-carousel">
        <div class="embla__container flex">
          {
            testimonials.map((test) => (
              <div class="embla__slide flex-[0_0_100%] sm:flex-[0_0_50%] lg:flex-[0_0_33.333333%] xl:flex-[0_0_25%] min-w-0 px-3 py-6">
                <div class="bg-white border border-[#0b3d1b]/10 rounded-2xl p-6 shadow-sm hover:shadow-md hover:border-[#0b3d1b]/30 transition-all duration-300 h-full flex flex-col justify-between relative group/card">
                  <div>
                    <!-- Decorative Quote Icon (Subtle & Elegant) -->
                    <span class="absolute top-2 right-4 text-7xl text-[#0b3d1b]/10 font-serif leading-none select-none group-hover/card:text-[#0b3d1b]/20 transition-colors duration-300">“</span>
                    
                    <div class="flex items-center gap-4 mb-4">
                      <div class="w-14 h-14 bg-slate-50 border border-slate-100 rounded-full flex items-center justify-center p-2 shadow-inner">
                        <img src={test.logo} alt={`${test.name} Logo`} class="w-full h-auto object-contain" />
                      </div>
                      <div>
                        <h4 class="font-bold text-[#0b3d1b] text-base mb-1 uppercase tracking-wider">{test.name}</h4>
                        <div class="flex items-center gap-1.5">
                          <div class="flex text-[#ffb800] gap-0.5">
                            {[...Array(5)].map(() => (
                              <span class="material-icons text-base">star</span>
                            ))}
                          </div>
                          <span class="text-slate-500 font-bold text-xs">{test.rating.toFixed(1)}</span>
                        </div>
                      </div>
                    </div>
                    
                    <p class="text-slate-600 text-sm leading-relaxed italic font-light">
                      {test.quote}
                    </p>
                  </div>
                  
                  <!-- Bottom Border Decor Line -->
                  <div class="w-12 h-1 bg-[#0b3d1b]/20 rounded-full mt-4 group-hover/card:bg-[#0b3d1b]/50 transition-colors duration-300"></div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Next Button -->
      <button 
        id="testimonial-next"
        class="absolute right-2 md:right-0 top-1/2 -translate-y-1/2 z-20 w-12 h-12 rounded-full bg-[#0b3d1b] hover:bg-[#155a2d] text-white flex items-center justify-center shadow-lg transition-all duration-300 disabled:opacity-30 disabled:cursor-not-allowed"
        aria-label="Next testimonial"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>

    <!-- Dots Indicators -->
    <div id="testimonial-dots" class="flex justify-center gap-2 mt-8"></div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/icon?family=Material+Icons');

  .embla__container {
    display: flex;
    user-select: none;
    -webkit-touch-callout: none;
    -khtml-user-select: none;
    -apple-system-tap-highlight-color: transparent;
  }
</style>

<script>
  import EmblaCarousel from 'embla-carousel'
  import Autoplay from 'embla-carousel-autoplay'

  const initTestimonials = () => {
    const emblaNode = document.querySelector('#testimonial-carousel') as HTMLElement
    const prevBtn = document.querySelector('#testimonial-prev') as HTMLButtonElement
    const nextBtn = document.querySelector('#testimonial-next') as HTMLButtonElement
    const dotsContainer = document.querySelector('#testimonial-dots') as HTMLElement

    if (!emblaNode || !prevBtn || !nextBtn || !dotsContainer) return

    const autoplayPlugin = Autoplay({ delay: 5000, stopOnInteraction: false })
    const emblaApi = EmblaCarousel(emblaNode, { 
      align: 'start',
      loop: true,
      containScroll: 'trimSnaps'
    }, [autoplayPlugin])

    // Generate Dots
    const slides = emblaApi.scrollSnapList()
    dotsContainer.innerHTML = ''
    slides.forEach((_, i) => {
      const dot = document.createElement('button')
      dot.className = 'w-3 h-3 rounded-full bg-[#6e8c6e]/40 transition-all duration-300 hover:bg-[#6e8c6e]/80'
      dot.setAttribute('aria-label', `Go to testimonial slide ${i + 1}`)
      dotsContainer.appendChild(dot)
    })

    const updateUI = () => {
      // Update Buttons
      prevBtn.disabled = !emblaApi.canScrollPrev()
      nextBtn.disabled = !emblaApi.canScrollNext()

      // Update Dots
      const selected = emblaApi.selectedScrollSnap()
      const dots = dotsContainer.querySelectorAll('button')
      dots.forEach((dot, i) => {
        if (i === selected) {
          dot.className = 'w-6 h-3 rounded-full bg-[#0b3d1b] transition-all duration-300'
        } else {
          dot.className = 'w-3 h-3 rounded-full bg-[#6e8c6e]/40 transition-all duration-300 hover:bg-[#6e8c6e]/80'
        }
      })
    }

    // Attach events
    prevBtn.addEventListener('click', () => {
      emblaApi.scrollPrev()
      autoplayPlugin.reset()
    })
    nextBtn.addEventListener('click', () => {
      emblaApi.scrollNext()
      autoplayPlugin.reset()
    })

    const dots = dotsContainer.querySelectorAll('button')
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        emblaApi.scrollTo(i)
        autoplayPlugin.reset()
      })
    })

    emblaApi.on('select', updateUI)
    emblaApi.on('init', updateUI)
    emblaApi.on('reInit', updateUI)

    updateUI()
  }

  document.addEventListener('DOMContentLoaded', initTestimonials)
  document.addEventListener('astro:page-load', initTestimonials)
</script>
