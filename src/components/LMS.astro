---
const lang = Astro.currentLocale || 'en';

const t = {
  en: {
    s1Title: "Gantry Scan",
    s1Sub: "Check In",
    s2Title: "Linen Sorting",
    s2Sub: "Color & Type",
    s3Title: "Washing, Drying",
    s3Sub: "& Ironing",
    s4Title: "Storage",
    s4Sub: "& Equipment",
    s5Title: "Gantry Scan",
    s5Sub: "Check Out",
    f1: "Hygiene Processing Center",
    f2: "Partner Healthcare Facility",
    s10Title: "Handheld Scan",
    s10Sub: "Check Out",
    s9Title: "Clean Linen",
    s9Sub: "Storage",
    s8Title: "Distribution",
    s8Sub: "to Wards",
    s7Title: "Dirty Linen",
    s7Sub: "from Wards",
    s6Title: "Handheld Scan",
    s6Sub: "Check In"
  },
  id: {
    s1Title: "Gantry Scan",
    s1Sub: "Check In",
    s2Title: "Penyortiran Linen",
    s2Sub: "Warna & Jenis",
    s3Title: "Proses Cuci, Kering",
    s3Sub: "& Setrika",
    s4Title: "Penyimpanan",
    s4Sub: "& Perlengkapan",
    s5Title: "Gantry Scan",
    s5Sub: "Check Out",
    f1: "Pusat Pengolahan Higienis",
    f2: "Fasilitas Kesehatan Mitra",
    s10Title: "Handheld Scan",
    s10Sub: "Check Out",
    s9Title: "Penyimpanan",
    s9Sub: "Linen Bersih",
    s8Title: "Distribusi",
    s8Sub: "Setiap Bangsal",
    s7Title: "Linen Kotor",
    s7Sub: "dari Bangsal",
    s6Title: "Handheld Scan",
    s6Sub: "Check In"
  }
}[lang];
---

<section id="lms-process" class="py-24 relative overflow-hidden bg-[#fafafa]">
  <!-- Professional Background Architecture -->
  <div class="absolute inset-0 z-0">
    <!-- Soft background gradient -->
    <div class="absolute inset-0 bg-gradient-to-br from-slate-50 via-white to-emerald-50/30"></div>
    
    <!-- Subtle Grid Pattern for 'Scientific/Technical' feel -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(#064e3b 0.5px, transparent 0.5px); background-size: 24px 24px;"></div>
    
    <!-- Large ethereal blobs for depth -->
    <div class="absolute top-[-10%] right-[-10%] w-[600px] h-[600px] bg-emerald-100/20 blur-[120px] rounded-full animate-pulse"></div>
    <div class="absolute bottom-[-10%] left-[-10%] w-[600px] h-[600px] bg-teal-100/20 blur-[120px] rounded-full animate-pulse" style="animation-delay: 2s;"></div>
  </div>

  <div class="max-w-[1440px] mx-auto px-8 relative z-10">
    
    <!-- DESKTOP LAYOUT -->
    <div class="hidden lg:block relative w-full">
      
      <!-- Background Connecting Loop (Sophisticated dashed line) -->
      <svg class="absolute inset-0 w-full h-full pointer-events-none opacity-[0.15] z-0 lms-reveal" viewBox="0 0 1400 600">
        <rect x="150" y="80" width="1100" height="440" rx="220" fill="none" stroke="#059669" stroke-width="2" stroke-dasharray="8 12" />
      </svg>

      <!-- Top Row: Laundry Processing -->
      <div class="flex justify-between items-center relative z-10 px-4">
        <!-- Step 1 -->
        <div class="group lms-reveal" data-delay="0">
          <div class="bg-white border border-slate-100 shadow-[0_4px_20px_rgba(0,0,0,0.03)] rounded-[20px] p-3 xl:p-5 w-44 xl:w-52 text-center transition-all duration-500 hover:shadow-[0_20px_40px_rgba(5,150,105,0.08)] hover:-translate-y-2 relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-emerald-400 to-teal-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <span class="text-[10px] uppercase tracking-[0.2em] text-emerald-600 font-bold mb-2 block opacity-60">Step 01</span>
            <p class="text-[15px] font-bold text-slate-800 leading-tight">{t.s1Title}<br/><span class="text-emerald-700">{t.s1Sub}</span></p>
          </div>
        </div>

        <div class="text-emerald-400/40 flex items-center justify-center lms-arrow-reveal" data-delay="0.15">
          <svg class="w-8 h-8 animate-[bounce-x_2s_infinite]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
          </svg>
        </div>

        <!-- Step 2 -->
        <div class="group lms-reveal" data-delay="0.15">
          <div class="bg-white border border-slate-100 shadow-[0_4px_20px_rgba(0,0,0,0.03)] rounded-[20px] p-3 xl:p-5 w-44 xl:w-52 text-center transition-all duration-500 hover:shadow-[0_20px_40px_rgba(5,150,105,0.08)] hover:-translate-y-2 relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-emerald-400 to-teal-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <span class="text-[10px] uppercase tracking-[0.2em] text-emerald-600 font-bold mb-2 block opacity-60">Step 02</span>
            <p class="text-[15px] font-bold text-slate-800 leading-tight">{t.s2Title}<br/><span class="font-medium text-slate-500">{t.s2Sub}</span></p>
          </div>
        </div>

        <div class="text-emerald-400/40 flex items-center justify-center lms-arrow-reveal" data-delay="0.25">
          <svg class="w-8 h-8 animate-[bounce-x_2s_infinite]" style="animation-delay: 0.5s" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
          </svg>
        </div>

        <!-- Step 3 -->
        <div class="group lms-reveal" data-delay="0.3">
          <div class="bg-emerald-900 shadow-[0_20px_40px_rgba(6,78,59,0.2)] rounded-[20px] p-3 xl:p-5 w-44 xl:w-52 text-center transition-all duration-500 hover:-translate-y-2 relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_top_right,rgba(16,185,129,0.1),transparent)]"></div>
            <span class="text-[10px] uppercase tracking-[0.2em] text-emerald-400 font-bold mb-2 block opacity-60">Step 03</span>
            <p class="text-[15px] font-bold text-white leading-tight">{t.s3Title}<br/><span class="text-emerald-400">{t.s3Sub}</span></p>
          </div>
        </div>

        <div class="text-emerald-400/40 flex items-center justify-center lms-arrow-reveal" data-delay="0.4">
          <svg class="w-8 h-8 animate-[bounce-x_2s_infinite]" style="animation-delay: 1s" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
          </svg>
        </div>

        <!-- Step 4 -->
        <div class="group lms-reveal" data-delay="0.45">
          <div class="bg-white border border-slate-100 shadow-[0_4px_20px_rgba(0,0,0,0.03)] rounded-[20px] p-3 xl:p-5 w-44 xl:w-52 text-center transition-all duration-500 hover:shadow-[0_20px_40px_rgba(5,150,105,0.08)] hover:-translate-y-2 relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-emerald-400 to-teal-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <span class="text-[10px] uppercase tracking-[0.2em] text-emerald-600 font-bold mb-2 block opacity-60">Step 04</span>
            <p class="text-[15px] font-bold text-slate-800 leading-tight">{t.s4Title}<br/><span class="font-medium text-slate-500">{t.s4Sub}</span></p>
          </div>
        </div>

        <div class="text-emerald-400/40 flex items-center justify-center lms-arrow-reveal" data-delay="0.55">
          <svg class="w-8 h-8 animate-[bounce-x_2s_infinite]" style="animation-delay: 1.5s" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
          </svg>
        </div>

        <!-- Step 5 -->
        <div class="group lms-reveal" data-delay="0.6">
          <div class="bg-white border border-slate-100 shadow-[0_4px_20px_rgba(0,0,0,0.03)] rounded-[20px] p-3 xl:p-5 w-44 xl:w-52 text-center transition-all duration-500 hover:shadow-[0_20px_40px_rgba(5,150,105,0.08)] hover:-translate-y-2 relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-emerald-400 to-teal-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <span class="text-[10px] uppercase tracking-[0.2em] text-emerald-600 font-bold mb-2 block opacity-60">Step 05</span>
            <p class="text-[15px] font-bold text-slate-800 leading-tight">{t.s5Title}<br/><span class="text-emerald-700">{t.s5Sub}</span></p>
          </div>
        </div>
      </div>

      <!-- Middle Row: High-End Visuals -->
      <div class="flex justify-between items-center w-full my-16 relative z-10">
        <!-- Facility Visual -->
        <div class="relative w-[260px] xl:w-[320px] lms-reveal from-left" data-delay="0.1">
          <div class="absolute -inset-4 bg-emerald-500/5 blur-2xl rounded-full"></div>
          <div class="relative rounded-[40px] overflow-hidden border-[12px] border-white shadow-2xl group">
            <img src="/images/visi.jpeg" alt="Laundry Facility" class="w-full h-[200px] xl:h-[240px] object-cover transition-transform duration-1000 group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-t from-emerald-950/90 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-8">
               <p class="text-white text-sm font-medium tracking-wide">{t.f1}</p>
            </div>
          </div>
          <!-- Vertical Flow Indicators -->
          <div class="absolute top-[-40px] left-1/2 -translate-x-1/2 text-emerald-400/30 animate-pulse">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
          </div>
          <div class="absolute bottom-[-40px] left-1/2 -translate-x-1/2 text-emerald-400/30 animate-pulse">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
          </div>
        </div>

        <!-- Center Branding -->
        <div class="text-center relative py-10 px-16">
          <div class="absolute inset-0 bg-emerald-50/50 rounded-full blur-3xl -z-10"></div>
          <h2 class="font-display text-5xl xl:text-7xl font-black text-emerald-950 mb-4 lms-title-anim" data-delay="0.2">LMS</h2>
          <div class="h-px bg-emerald-200 mx-auto mb-6 lms-divider-anim" data-delay="0.4"></div>
          <p class="text-lg font-serif italic text-emerald-800/60 tracking-widest uppercase lms-reveal" data-delay="0.5">Laundry Management System</p>
          <p class="mt-4 text-[11px] text-slate-400 font-bold uppercase tracking-[0.3em] lms-reveal" data-delay="0.65">Smart Healthcare Solution</p>
        </div>

        <!-- Hospital Visual -->
        <div class="relative w-[260px] xl:w-[320px] lms-reveal from-right" data-delay="0.1">
          <div class="absolute -inset-4 bg-teal-500/5 blur-2xl rounded-full"></div>
          <div class="relative rounded-[40px] overflow-hidden border-[12px] border-white shadow-2xl group">
            <img src="https://images.unsplash.com/photo-1586773860418-d37222d8fce3?q=80&w=800&auto=format&fit=crop" alt="Hospital Facility" class="w-full h-[200px] xl:h-[240px] object-cover transition-transform duration-1000 group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-t from-teal-950/90 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-8">
               <p class="text-white text-sm font-medium tracking-wide">{t.f2}</p>
            </div>
          </div>
          <!-- Vertical Flow Indicators -->
          <div class="absolute top-[-40px] left-1/2 -translate-x-1/2 text-emerald-400/30 animate-pulse">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
          </div>
          <div class="absolute bottom-[-40px] left-1/2 -translate-x-1/2 text-emerald-400/30 animate-pulse">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
          </div>
        </div>
      </div>

      <!-- Bottom Row: Hospital Processing (Reverse Order) -->
      <div class="flex justify-between items-center relative z-10 px-4">
        <!-- Step 10 -->
        <div class="group lms-reveal" data-delay="0">
          <div class="bg-white border border-slate-100 shadow-[0_4px_20px_rgba(0,0,0,0.03)] rounded-[20px] p-3 xl:p-5 w-44 xl:w-52 text-center transition-all duration-500 hover:shadow-[0_20px_40px_rgba(5,150,105,0.08)] hover:translate-y-2 relative overflow-hidden">
            <div class="absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-emerald-400 to-teal-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <span class="text-[10px] uppercase tracking-[0.2em] text-emerald-600 font-bold mb-2 block opacity-60">Step 10</span>
            <p class="text-[15px] font-bold text-slate-800 leading-tight">{t.s10Title}<br/><span class="text-emerald-700">{t.s10Sub}</span></p>
          </div>
        </div>

        <div class="text-emerald-400/40 flex items-center justify-center lms-arrow-reveal" data-delay="0.15">
          <svg class="w-8 h-8 animate-[bounce-x-reverse_2s_infinite]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 17l-5-5m0 0l5-5m-5 5h12"/>
          </svg>
        </div>

        <!-- Step 09 -->
        <div class="group lms-reveal" data-delay="0.15">
          <div class="bg-white border border-slate-100 shadow-[0_4px_20px_rgba(0,0,0,0.03)] rounded-[20px] p-3 xl:p-5 w-44 xl:w-52 text-center transition-all duration-500 hover:shadow-[0_20px_40px_rgba(5,150,105,0.08)] hover:translate-y-2 relative overflow-hidden">
            <div class="absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-emerald-400 to-teal-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <span class="text-[10px] uppercase tracking-[0.2em] text-emerald-600 font-bold mb-2 block opacity-60">Step 09</span>
            <p class="text-[15px] font-bold text-slate-800 leading-tight">{t.s9Title}<br/><span class="text-emerald-700">{t.s9Sub}</span></p>
          </div>
        </div>

        <div class="text-emerald-400/40 flex items-center justify-center lms-arrow-reveal" data-delay="0.25">
          <svg class="w-8 h-8 animate-[bounce-x-reverse_2s_infinite]" style="animation-delay: 0.5s" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 17l-5-5m0 0l5-5m-5 5h12"/>
          </svg>
        </div>

        <!-- Step 08 -->
        <div class="group lms-reveal" data-delay="0.3">
          <div class="bg-white border border-slate-100 shadow-[0_4px_20px_rgba(0,0,0,0.03)] rounded-[20px] p-3 xl:p-5 w-44 xl:w-52 text-center transition-all duration-500 hover:shadow-[0_20px_40px_rgba(5,150,105,0.08)] hover:translate-y-2 relative overflow-hidden">
            <div class="absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-emerald-400 to-teal-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <span class="text-[10px] uppercase tracking-[0.2em] text-emerald-600 font-bold mb-2 block opacity-60">Step 08</span>
            <p class="text-[15px] font-bold text-slate-800 leading-tight">{t.s8Title}<br/><span class="text-slate-500 font-medium">{t.s8Sub}</span></p>
          </div>
        </div>

        <div class="text-emerald-400/40 flex items-center justify-center lms-arrow-reveal" data-delay="0.4">
          <svg class="w-8 h-8 animate-[bounce-x-reverse_2s_infinite]" style="animation-delay: 1s" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 17l-5-5m0 0l5-5m-5 5h12"/>
          </svg>
        </div>

        <!-- Step 07 -->
        <div class="group lms-reveal" data-delay="0.45">
          <div class="bg-white border border-slate-100 shadow-[0_4px_20px_rgba(0,0,0,0.03)] rounded-[20px] p-3 xl:p-5 w-44 xl:w-52 text-center transition-all duration-500 hover:shadow-[0_20px_40px_rgba(5,150,105,0.08)] hover:translate-y-2 relative overflow-hidden">
            <div class="absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-emerald-400 to-teal-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <span class="text-[10px] uppercase tracking-[0.2em] text-emerald-600 font-bold mb-2 block opacity-60">Step 07</span>
            <p class="text-[15px] font-bold text-slate-800 leading-tight">{t.s7Title}<br/><span class="text-slate-500 font-medium">{t.s7Sub}</span></p>
          </div>
        </div>

        <div class="text-emerald-400/40 flex items-center justify-center lms-arrow-reveal" data-delay="0.55">
          <svg class="w-8 h-8 animate-[bounce-x-reverse_2s_infinite]" style="animation-delay: 1.5s" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 17l-5-5m0 0l5-5m-5 5h12"/>
          </svg>
        </div>

        <!-- Step 06 -->
        <div class="group lms-reveal" data-delay="0.6">
          <div class="bg-white border border-slate-100 shadow-[0_4px_20px_rgba(0,0,0,0.03)] rounded-[20px] p-3 xl:p-5 w-44 xl:w-52 text-center transition-all duration-500 hover:shadow-[0_20px_40px_rgba(5,150,105,0.08)] hover:translate-y-2 relative overflow-hidden">
            <div class="absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-emerald-400 to-teal-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <span class="text-[10px] uppercase tracking-[0.2em] text-emerald-600 font-bold mb-2 block opacity-60">Step 06</span>
            <p class="text-[15px] font-bold text-slate-800 leading-tight">{t.s6Title}<br/><span class="text-emerald-700">{t.s6Sub}</span></p>
          </div>
        </div>
      </div>

    </div>

    <!-- MOBILE LAYOUT -->
    <div class="lg:hidden">
      <div class="text-center mb-16">
        <h2 class="font-display text-5xl font-black text-emerald-950 mb-4 lms-title-anim" data-delay="0">LMS</h2>
        <p class="text-lg font-serif italic text-emerald-800/60 uppercase tracking-widest lms-reveal" data-delay="0.2">Laundry Management System</p>
      </div>

      <div class="space-y-12 max-w-lg mx-auto relative px-4">
        <!-- Connecting Line -->
        <div class="absolute left-[34px] top-0 bottom-0 w-px bg-emerald-100 lms-line-draw"></div>

        {[
          { step: "01", title: t.s1Title, sub: t.s1Sub, img: "/images/visi.jpeg", isMain: true },
          { step: "02", title: t.s2Title, sub: t.s2Sub },
          { step: "03", title: t.s3Title, sub: t.s3Sub, highlight: true },
          { step: "04", title: t.s4Title, sub: t.s4Sub },
          { step: "05", title: t.s5Title, sub: t.s5Sub },
          { step: "06", title: t.s6Title, sub: t.s6Sub, img: "https://images.unsplash.com/photo-1586773860418-d37222d8fce3?q=80&w=800&auto=format&fit=crop", isMain: true },
          { step: "07", title: t.s7Title, sub: t.s7Sub },
          { step: "08", title: t.s8Title, sub: t.s8Sub },
          { step: "09", title: t.s9Title, sub: t.s9Sub },
          { step: "10", title: t.s10Title, sub: t.s10Sub }
        ].map((item, idx) => (
          <div class="relative flex gap-8 group lms-reveal" data-delay={String(idx * 0.1)}>
            <!-- Icon/Step Indicator -->
            <div class={`relative z-10 w-10 h-10 rounded-full flex items-center justify-center text-[10px] font-bold shadow-xl border-4 border-white shrink-0 lms-dot-reveal ${item.highlight ? 'bg-emerald-600 text-white' : item.isMain ? 'bg-emerald-950 text-white' : 'bg-white text-emerald-600'}`} data-delay={String(idx * 0.1 + 0.05)}>
              {item.step}
            </div>

            <!-- Content -->
            <div class="flex-1">
              <div class={`p-6 rounded-3xl border transition-all duration-300 ${item.highlight ? 'bg-emerald-900 border-emerald-800 shadow-2xl' : 'bg-white border-slate-50 shadow-sm group-hover:shadow-xl'}`}>
                <p class={`text-[11px] uppercase tracking-widest font-bold mb-1 opacity-50 ${item.highlight ? 'text-emerald-400' : 'text-emerald-600'}`}>Process Detail</p>
                <h3 class={`text-lg font-bold mb-1 ${item.highlight ? 'text-white' : 'text-slate-800'}`}>{item.title}</h3>
                <p class={`text-sm ${item.highlight ? 'text-emerald-100/60' : 'text-slate-500'}`}>{item.sub}</p>
                
                {item.img && (
                  <div class="mt-4 rounded-2xl overflow-hidden border-2 border-slate-50 aspect-[16/7]">
                    <img src={item.img} alt={item.title} class="w-full h-full object-cover" />
                  </div>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style is:global>
  @keyframes bounce-x {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(5px); }
  }
  @keyframes bounce-x-reverse {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(-5px); }
  }
  .animate-\[bounce-x_2s_infinite\] {
    animation: bounce-x 2s infinite;
  }
  .animate-\[bounce-x-reverse_2s_infinite\] {
    animation: bounce-x-reverse 2s infinite;
  }

  /* ── Scroll Reveal: initial hidden states ── */
  .lms-reveal {
    opacity: 0;
    transform: translateY(36px);
    transition: opacity 0.7s cubic-bezier(0.22,1,0.36,1), transform 0.7s cubic-bezier(0.22,1,0.36,1);
  }
  .lms-reveal.from-left  { transform: translateX(-48px); }
  .lms-reveal.from-right { transform: translateX(48px); }
  .lms-reveal.is-visible {
    opacity: 1 !important;
    transform: none !important;
  }

  .lms-arrow-reveal {
    opacity: 0;
    transition: opacity 0.45s ease;
  }
  .lms-arrow-reveal.is-visible { opacity: 1 !important; }

  .lms-line-draw {
    transform-origin: top center;
    transform: scaleY(0);
    transition: transform 1.6s cubic-bezier(0.22,1,0.36,1);
  }
  .lms-line-draw.is-visible { transform: scaleY(1) !important; }

  @keyframes lms-dot-pop {
    0%   { transform: scale(0); opacity: 0; }
    60%  { transform: scale(1.25); opacity: 1; }
    100% { transform: scale(1); opacity: 1; }
  }
  .lms-dot-reveal {
    opacity: 0;
    transform: scale(0);
  }
  .lms-dot-reveal.is-visible {
    animation: lms-dot-pop 0.55s cubic-bezier(0.22,1,0.36,1) forwards !important;
  }

  @keyframes lms-title-glow {
    0%   { letter-spacing: 0.05em; opacity: 0; filter: blur(10px); }
    100% { letter-spacing: 0.25em; opacity: 1; filter: blur(0px); }
  }
  .lms-title-anim { opacity: 0; }
  .lms-title-anim.is-visible {
    animation: lms-title-glow 1s cubic-bezier(0.22,1,0.36,1) forwards !important;
  }

  @keyframes lms-line-expand {
    from { width: 0px; }
    to   { width: 8rem; }
  }
  .lms-divider-anim { width: 0; overflow: hidden; }
  .lms-divider-anim.is-visible {
    animation: lms-line-expand 0.9s 0.3s cubic-bezier(0.22,1,0.36,1) forwards !important;
  }

  @media (prefers-reduced-motion: reduce) {
