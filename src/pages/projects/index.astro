---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import fs from "node:fs";
import path from "node:path";

import { projectsData } from "../../data/projects.js";

const projects = projectsData.map((project) => {
  if (project.folderName) {
    try {
      const folderPath = path.join(
        process.cwd(),
        "public",
        "images",
        "project",
        project.folderName,
      );
      if (fs.existsSync(folderPath)) {
        const files = fs.readdirSync(folderPath);
        const images = files.filter((f) =>
          [".jpg", ".jpeg", ".png", ".webp"].includes(
            path.extname(f).toLowerCase(),
          ),
        );
        if (images.length > 0) {
          return {
            ...project,
            image: `/images/project/${project.folderName}/${images[0]}`,
          };
        }
      }
    } catch (e) {}
  }
  return project;
});
---

<Layout title="Our Projects | PT BACY">
  <Navbar />

  <main class="pt-20 pb-8">
    <div class="max-w-7xl mx-auto px-6">
      <header class="mb-8 border-b border-primary/10 pb-12">
        <span
          class="text-primary font-bold tracking-[0.2em] uppercase text-sm mb-2 block"
          >Portfolio</span
        >
        <h1
          class="font-display text-5xl md:text-6xl text-secondary font-bold mb-6 italic"
        >
          OUR PROJECTS
        </h1>
        <p class="text-slate-500 max-w-2xl text-lg">
          A curated collection of our finest work across residential,
          commercial, and hospitality sectors. Each project is a testament to
          our commitment to quality and design excellence.
        </p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          projects.map((project) => (
            <a
              href={`/projects/${project.slug}`}
              class="group cursor-pointer block"
            >
              <div class="bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-500 overflow-hidden mb-4 relative aspect-[4/3]">
                <img
                  alt={project.title}
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                  src={project.image}
                  onerror="this.src='https://placehold.co/800x600?text=Project+Image'"
                />
                <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-500" />
                <div class="absolute bottom-0 left-0 right-0 p-6 bg-gradient-to-t from-black/80 to-transparent text-white translate-y-4 group-hover:translate-y-0 transition-transform">
                  <p class="text-xs font-bold uppercase tracking-wider mb-1 text-primary">
                    {project.category}
                  </p>
                  <h3 class="font-display text-xl font-bold">
                    {project.title}
                  </h3>
                </div>
              </div>
              <div class="px-2">
                <p class="text-sm text-slate-500 line-clamp-3">
                  {project.description}
                </p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </main>
</Layout>

<script>
  import {
    getWatermarkedDataUrl,
    preloadWatermark,
  } from "../../utils/watermark.js";

  function initGhostWatermark() {
    const images = document.querySelectorAll("main img");

    images.forEach((img) => {
      if (!(img instanceof HTMLImageElement)) return;

      const originalSrc = img.src;
      let isWatermarked = false;

      // Preload saat halaman dimuat
      if (originalSrc && !originalSrc.startsWith("data:")) {
        preloadWatermark(originalSrc);
      }

      img.addEventListener("contextmenu", async (e) => {
        if (isWatermarked || img.src.startsWith("data:")) return;

        try {
          const watermarkedSrc = await getWatermarkedDataUrl(originalSrc);
          img.src = watermarkedSrc;
          isWatermarked = true;

          setTimeout(() => {
            if (isWatermarked && !img.matches(":hover")) {
              img.src = originalSrc;
              isWatermarked = false;
            }
          }, 3000);
        } catch (err) {
          console.error("Gagal menyiapkan watermark:", err);
        }
      });

      img.addEventListener("mouseleave", () => {
        if (isWatermarked) {
          img.src = originalSrc;
          isWatermarked = false;
        }
      });
    });
  }

  window.addEventListener("DOMContentLoaded", initGhostWatermark);
  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    initGhostWatermark();
  }
</script>
